#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    format_tag_separator: " | ",
    browser_column_widths: [20, 38, 42],
    background_color: None,
    text_color: "#cdd6f4",
    header_background_color: None,
    modal_background_color: "#11111b",
    modal_backdrop: false,
    preview_label_style: (fg: "#f9e2af"),
    preview_metadata_group_style: (fg: "#89b4fa", modifiers: "Bold"),
    highlighted_item_style: (fg: "#cba6f7", modifiers: "Bold"),
    current_item_style: (fg: "#cba6f7", modifiers: "Bold | Underlined"),
    borders_style: (fg: "#cba6f7"),
    highlight_border_style: (fg: "#cba6f7"),
    symbols: (
        song: "S",
        dir: "D",
        playlist: "P",
        marker: "M",
        ellipsis: "...",
        song_style: (fg: "#89dceb"),
        dir_style: (fg: "#89b4fa"),
        playlist_style: (fg: "#f5e0dc"),
    ),
    level_styles: (
        info: (fg: "#74c7ec", bg: "#11111b"),
        warn: (fg: "#f9e2af", bg: "#11111b"),
        error: (fg: "#dc2626", bg: "#11111b"),
        debug: (fg: "#a6e3a1", bg: "#11111b"),
        trace: (fg: "#f5c2e7", bg: "#11111b"),
    ),
    progress_bar: (
        symbols: ["█", "█", "█", " ", "█"],
        track_style: None,
        elapsed_style: (fg: "#cba6f7"),
        thumb_style: (fg: "#cba6f7"),
        use_track_when_empty: true,
    ),
    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        track_style: (),
        ends_style: (fg: "#6c7086"),
        thumb_style: (fg: "#cba6f7"),
    ),
    tab_bar: (
        active_style: (fg: "#11111b", bg: "#cba6f7", modifiers: "Bold"),
        inactive_style: (fg: "#6c7086"),
    ),
    lyrics: (
        timestamp: false
    ),
    // Per-field `style:` below (Artist/Title) is confirmed INERT for this
    // specific list -- read rmpc's own source (ui/dirstack/mod.rs) directly:
    // songs shown while browsing (Directories/Artists/Album Artists/Albums)
    // render through Property<SongProperty>::as_string, which discards
    // style entirely; only song_table_format (Queue/Playlists/Search)
    // goes through the style-aware as_line path. Left set anyway rather
    // than stripped -- harmless, and starts working for free if rmpc ever
    // adds style support here. The only real color lever for these rows
    // is symbols.song_style/dir_style/playlist_style below, which colors
    // just the one-character type marker before each name, not the name
    // itself.
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track)),
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Artist), style: (fg: "#b4befe")),
                (kind: Text(" - ")),
                (kind: Property(Title), style: (fg: "#89dceb")),
            ]),
            default: (kind: Property(Filename))
        ),
    ],
    song_table_format: [
        (
            prop: (kind: Property(Artist), style: (fg: "#b4befe"),
                default: (kind: Text("Unknown"), style: (fg: "#b4befe"))
            ),
            label_prop: (kind: Text("Artist"), style: (fg: "#b4befe")),
            width: "20%",
        ),
        (
            prop: (kind: Property(Title), style: (fg: "#89dceb"),
                default: (kind: Text("Unknown"), style: (fg: "#89dceb"))
            ),
            label_prop: (kind: Text("Title"), style: (fg: "#89dceb")),
            width: "35%",
        ),
        (
            prop: (kind: Property(Album), style: (fg: "#f5e0dc"),
                default: (kind: Text("Unknown Album"), style: (fg: "#f5e0dc"))
            ),
            label_prop: (kind: Text("Album"), style: (fg: "#f5e0dc")),
            width: "30%",
        ),
        (
            prop: (kind: Property(Duration), style: (fg: "#fab387"),
                default: (kind: Text("-"), style: (fg: "#fab387"))
            ),
            label_prop: (kind: Text("Duration"), style: (fg: "#fab387")),
            width: "15%",
            alignment: Right,
        ),
    ],
    layout: Split(
        direction: Vertical,
        panes: [
            (
                size: "4",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            size: "35",
                            borders: "LEFT | TOP | BOTTOM",
                            border_symbols: Inherited(parent: Rounded, bottom_left: "├"),
                            pane: Component("header_left")
                        ),
                        (
                            size: "100%",
                            borders: "ALL",
                            border_symbols: Inherited(parent: Rounded, top_left: "┬", top_right: "┬", bottom_left: "┴", bottom_right: "┴"),
                            pane: Component("header_center")
                        ),
                        (
                            size: "35",
                            borders: "RIGHT | TOP | BOTTOM",
                            border_symbols: Inherited(parent: Rounded, bottom_right: "┤"),
                            pane: Component("header_right")
                        ),
                    ]
                )
            ),
            (
                pane: Pane(Tabs),
                borders: "RIGHT | LEFT | BOTTOM",
                border_symbols: Rounded,
                size: "2",
            ),
            (
                pane: Pane(TabContent),
                size: "100%",
            ),
            (
                size: "3",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            size: "12",
                            borders: "ALL",
                            border_symbols: Inherited(parent: Rounded, top_right: "┬", bottom_right: "┴"),
                            pane: Component("input_mode")
                        ),
                        (
                            size: "100%",
                            borders: "TOP | BOTTOM | RIGHT",
                            border_symbols: Rounded,
                            border_title: [(kind: Text(" ")), (kind: Property(Status(QueueLength()))), (kind: Text(" songs / ")), (kind: Property(Status(QueueTimeTotal()))), (kind: Text(" total time "))],
                            border_title_alignment: Right,
                            pane: Component("progress_bar"),
                        ),
                    ]
                ),
            ),
        ],
    ),
    components: {
        "state": Pane(Property(
            content: [
                (kind: Text("["), style: (fg: "#f9e2af", modifiers: "Bold")),
                (kind: Property(Status(StateV2( ))), style: (fg: "#f9e2af", modifiers: "Bold")),
                (kind: Text("]"), style: (fg: "#f9e2af", modifiers: "Bold")),
            ], align: Left,
        )),
        "title": Pane(Property(
            content: [
                (kind: Property(Song(Title)), style: (fg: "#89dceb", modifiers: "Bold"),
                    default: (kind: Text("No Song"), style: (fg: "#89dceb", modifiers: "Bold"))),
            ], align: Center, scroll_speed: 1
        )),
        "volume": Split(
            direction: Horizontal,
            panes: [
                (size: "1", pane: Pane(Property(content: [(kind: Text(""))]))),
                (size: "100%", pane: Pane(Volume(kind: Slider(symbols: (filled: "─", thumb: "●", track: "─"))))),
                (size: "3", pane: Pane(Property(content: [(kind: Property(Status(Volume)), style: (fg: "#eba0ac"))], align: Right))),
                (size: "2", pane: Pane(Property(content: [(kind: Text("%"), style: (fg: "#eba0ac"))]))),
            ]
        ),
        "elapsed_and_bitrate": Pane(Property(
            content: [
                (kind: Property(Status(Elapsed)), style: (fg: "#a6e3a1")), 
                (kind: Text(" / ")), 
                (kind: Property(Status(Duration)), style: (fg: "#a6e3a1")), 
                (kind: Group([
                    (kind: Text(" (")), 
                    (kind: Property(Status(Bitrate)), style: (fg: "#a6e3a1")), 
                    (kind: Text(" kbps)")),
                ])),
            ],
            align: Left,
        )),
        "artist_and_album": Pane(Property(
            content: [
                (kind: Property(Song(Artist)), style: (fg: "#b4befe", modifiers: "Bold"),
                    default: (kind: Text("Unknown"), style: (fg: "#b4befe", modifiers: "Bold"))),
                (kind: Text(" - ")),
                (kind: Property(Song(Album)), default: (kind: Text("Unknown Album"))),
            ], align: Center, scroll_speed: 1
        )),
        "states": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
                (
                    size: "100%",
                    pane: Pane(Property(content: [(kind: Property(Status(InputBuffer())), style: (fg: "#cba6f7"), align: Left)]))
                ),
                (
                    size: "6",
                    pane: Pane(Property(content: [
                        (kind: Text("["), style: (fg: "#cba6f7", modifiers: "Bold")),
                        (kind: Property(Status(RepeatV2(
                            on_label: "z",
                            off_label: "z",
                            on_style: (fg: "#94e2d5", modifiers: "Bold"),
                            off_style: (fg: "#6c7086", modifiers: "Dim"),
                        )))),
                        (kind: Property(Status(RandomV2(
                            on_label: "x",
                            off_label: "x",
                            on_style: (fg: "#fab387", modifiers: "Bold"),
                            off_style: (fg: "#6c7086", modifiers: "Dim"),
                        )))),
                        (kind: Property(Status(ConsumeV2(
                            on_label: "c",
                            off_label: "c",
                            oneshot_label: "c",
                            on_style: (fg: "#74c7ec", modifiers: "Bold"),
                            off_style: (fg: "#6c7086", modifiers: "Dim"),
                            oneshot_style: (fg: "#f38ba8", modifiers: "Dim"),
                        )))),
                        (kind: Property(Status(SingleV2(
                            on_label: "v",
                            off_label: "v",
                            oneshot_label: "v",
                            on_style: (fg: "#b4befe", modifiers: "Bold"),
                            off_style: (fg: "#6c7086", modifiers: "Dim"),
                            oneshot_style: (fg: "#f38ba8", modifiers: "Bold"),
                        )))),
                        (kind: Text("]"), style: (fg: "#cba6f7", modifiers: "Bold")),
                        ],
                        align: Right
                    ))
                ),
            ]
        ),
        "input_mode": Pane(Property(
            content: [
                (kind: Transform(Replace(content: (kind: Property(Status(InputMode()))), replacements: [
                    (match: "Normal", replace: (kind: Text(" NORMAL "), style: (fg: "#11111b", bg: "#cba6f7"))),
                    (match: "Insert", replace: (kind: Text(" INSERT "), style: (fg: "#11111b", bg: "#a6e3a1"))),
                ])))
            ], align: Center
        )),
        "header_left": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("state")),
                (size: "1", pane: Component("elapsed_and_bitrate")),
            ]
        ),
        "header_center": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("title")),
                (size: "1", pane: Component("artist_and_album")),
            ]
        ),
        "header_right": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("volume")),
                (size: "1", pane: Component("states")),
            ]
        ),
        "progress_bar": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
                (
                    size: "100%",
                    pane: Pane(ProgressBar)
                ),
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
            ]
        )
    },
)
