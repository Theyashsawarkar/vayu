### User Executions & Environment Settings
# Import WAYLAND_DISPLAY/SWAYSOCK into the systemd --user manager's own
# environment FIRST -- it's separate from sway's process environment, and
# systemd --user services (like swayidle.service right below) can't reach
# the compositor at all until this has run. Learned this one from a real
# failure: swayidle.service crash-looped with "Unable to connect to the
# compositor" because this used to run near the end of this file, after
# the swayidle restart below had already fired.
exec dbus-update-activation-environment --all

exec waybar 
exec mako
# Reapplies whatever notification mode was last chosen -- mako's own
# mode selection resets to its built-in default on every restart/login,
# so without this, DND/silent would silently drop back to normal on
# every reboot. Bounded retry inside the script itself for the same
# mako-not-up-yet race dbus-update-activation-environment above exists
# to guard against elsewhere in this file.
exec ~/.local/bin/notification-mode-restore.sh

# Start the idle manager automatically
# Managed as a systemd user service (systemd/.config/systemd/user/swayidle.service)
# rather than a raw exec, so caffeine-toggle.sh can stop/start it cleanly via
# systemctl instead of juggling raw processes.
#
# Not a plain `systemctl restart` -- swayidle.service is `enabled`
# (WantedBy=default.target), so systemd auto-starts it at every login on
# its own regardless of caffeine mode's last state, meaning caffeine never
# survived a reboot. swayidle-startup.sh re-applies whatever was last
# chosen via the waybar caffeine toggle (see its own comments for the
# full reasoning) instead of unconditionally starting it here.
exec ~/.local/bin/swayidle-startup.sh
# Also a systemd user service now (systemd/.config/systemd/user/sway-audio-idle-inhibit.service)
# instead of a raw exec -- it crashed once connecting to the audio stack too
# early at login and never came back (plain exec doesn't restart on crash).
exec systemctl --user restart sway-audio-idle-inhibit.service

# Prevent idle timeouts when watching fullscreen videos
for_window [class=".*"] inhibit_idle fullscreen
for_window [app_id=".*"] inhibit_idle fullscreen

# System State Daemons (Notifications & Applets)
exec nm-applet --indicator
exec blueman-applet

# Battery Daemon: Warns at 20%, Critical at 10%, Forces Suspend at 5%.
# Systemd user service (systemd/.config/systemd/user/batsignal.service) rather
# than a raw exec: this had actually been silently broken this whole time --
# '-f LEVEL' is "battery FULL notification", not "force a command", and
# needed an argument it never got, so batsignal exited immediately on every
# launch. The real flag for "run a command at a level" is '-D COMMAND'.
# Restart=on-failure now too, so a future crash doesn't silently remove your
# only protection against an uncontrolled shutdown from battery depletion.
exec systemctl --user restart batsignal.service

# Clipboard history management
exec --no-startup-id cliphist store
exec --no-startup-id wl-paste --type text --watch cliphist store
exec --no-startup-id wl-paste --type image --watch cliphist store

include /etc/sway/config.d/*


