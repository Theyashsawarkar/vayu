# ==============================================================================
# SWAY CONFIGURATION - WAYLAND MINIMALIST ARCHITECTURE
# ==============================================================================

### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4

# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l

# Preferred Applications
set $term kitty

# Launcher and system panels: Vyom (github.com/Theyashsawarkar/vyom) and
# its tools, each its own repo (CLAUDE.md "Plugins"), replacing wofi and
# nwg-bar. One resident process (`exec vyom daemon` below), so every panel
# opens at once, and the same key again closes it (no toggle-popup.sh).
# Each tool's keys are in its footer and README, and in the keybinding
# search (Super+Shift+/).
set $vyom ~/.local/bin/vyom
set $menu $vyom dvara
set $calc $vyom ganit

#: Open clipboard history (smriti: links, images, code; pin, delete)
bindsym $mod+m exec $vyom smriti

#: Open emoji picker (bhava: types it into the window you were in)
bindsym $mod+period exec $vyom bhava

#: Open Wi-Fi panel (tarang: networks, connect, hotspot)
bindsym $mod+Shift+w exec $vyom tarang

#: Open Bluetooth panel (setu: devices, battery, pair, connect)
bindsym $mod+Shift+b exec $vyom setu

#: Open phone panel (doot, KDE Connect: send file, clipboard, ring, browse)
bindsym $mod+Shift+o exec $vyom doot

# Stops the laptop ringing (Find my device) if it is; otherwise, since
# mako's left click only runs a notification's default action, this lists
# all of them (Accept/Reject a pairing request, Undo a phone clipboard...).
#: Stop phone ring, else pick an action on the current notification (Accept, Reject, Undo...)
bindsym $mod+Ctrl+a exec ~/.local/bin/notification-actions.sh

# KDE Connect's own windows (the presentation-remote pointer overlay, its
# dialogs) float instead of tiling into the layout.
for_window [app_id="org.kde.kdeconnect.daemon"] floating enable, border none, sticky enable
for_window [app_id="kdeconnectd"] floating enable, border none, sticky enable

#: Open Docker panel (patra: containers, logs, restart, stop, shell)
bindsym $mod+Shift+d exec $vyom patra

#: Open notifications (suchana: on screen, history, do not disturb)
bindsym $mod+Shift+n exec $vyom suchana

#: Open power menu (vishram: lock, suspend, log out, reboot, power off)
bindsym $mod+Shift+p exec $vyom vishram

#: Open quick settings (kendra: Wi-Fi, Bluetooth, hotspot, DND, volume...)
bindsym $mod+q exec $vyom kendra

# Caffeine mode keyboard path -- was click-only via waybar's
# custom/caffeine module (on-click in waybar/config) until now. Direct
# exec straight to caffeine-toggle.sh, not toggle-popup.sh -- there's no
# picker window here to show/hide, just an instant on/off flip, same
# shape as $mod+Shift+q/kill or $mod+Shift+c/reload above rather than the
# wofi-popup bindings.
#
# Real bug, caught live: originally bound to $mod+Shift+k, which reads
# free from a plain grep for literal "+k" in this file -- but $up is set
# to "k" up top (vim-style h/j/k/l direction variables), and
# `bindsym $mod+Shift+$up move up` further down resolves to the exact
# same combination after variable substitution. Sway treats that as a
# real duplicate binding and threw up the red "There are errors in your
# config file" swaynag on every reload -- confirmed by bisecting (moving
# this line to $mod+Shift+j collided with $down's `move down` the same
# way; a grep for the literal keysym alone can't catch a
# variable-expanded collision like this). $mod+Shift+a is genuinely
# free -- checked against both literal binds and every $left/$down/$up/
# $right variable expansion this time -- and "a" for "Awake" fits the
# feature at least as well as "k" ever did.
#
# keybind-search.py describes a binding by the `#:` line directly above
# it (explicit, so an explanatory comment block like the one above can't
# leak into the search as its description any more).
#: Toggle caffeine mode: keep the screen awake, no auto-lock/suspend
bindsym $mod+Shift+a exec ~/.local/bin/caffeine-toggle.sh

# Waybar's Caps/Num Lock capsules update on a signal instead of polling
# every second. --release leaves the key itself alone: the lock still
# toggles, and waybar re-reads the LED once the key is up.
#: Update Caps Lock indicator in waybar (on key release)
bindsym --release Caps_Lock exec ~/.local/bin/waybar-signal 9
#: Update Num Lock indicator in waybar (on key release)
bindsym --release Num_Lock exec ~/.local/bin/waybar-signal 10

# nāda (github.com/Theyashsawarkar/nada, its own repo, cloned by
# install.sh into ~/.local/share/nada): the music player, replacing rmpc.
# MPD still plays (mpd.service, `mpd/` here is its mpd.conf); nāda is the
# window on top plus what MPD doesn't do -- YouTube streams, autoplay,
# synced lyrics, downloads, MPRIS. One resident process (`nada daemon`
# below); the key only toggles its window, and hiding it never stops the
# music. Floating and centred: a player you glance at, not a tile.
#: Toggle music player window (nāda)
bindsym $mod+Shift+m exec ~/.local/bin/nada
#: Toggle music play / pause (nāda, without opening it)
bindsym $mod+Mod1+space exec ~/.local/bin/nada ctl toggle
#: Play next song (nāda)
bindsym $mod+Mod1+period exec ~/.local/bin/nada ctl next
#: Play previous song (nāda)
bindsym $mod+Mod1+comma exec ~/.local/bin/nada ctl prev
for_window [app_id="^dev\.vayu\.Nada$"] floating enable, resize set 1180 720, move position center, blur enable, corner_radius 20, shadows enable
# Settings: vinyasa (github.com/Theyashsawarkar/vinyasa, installed by kosha):
# themes for every tool (through varna), fonts, wallpaper, windows. Floating
# glass, like nāda.
#: Open settings (vinyasa: theme, fonts, wallpaper, windows, tools)
bindsym $mod+comma exec ~/.local/bin/vinyasa
#: Open settings (vinyasa, second key)
bindsym $mod+Shift+equal exec ~/.local/bin/vinyasa
for_window [app_id="^dev\.vayu\.Vinyasa$"] floating enable, resize set 1180 760, move position center, blur enable, corner_radius 20, shadows enable
# The mini player (nāda's `z`) is a layer-shell surface in the corner.
layer_effects "nada" {
    blur enable
    corner_radius 18
    shadows enable
}

# anumati's approval window (github.com/Theyashsawarkar/anumati, root
# commands for AI agents): float it centred with the glass blur the other
# popups have, above whatever is on screen.
for_window [app_id="^io\.github\.theyashsawarkar\.Anumati$"] floating enable, move position center, blur enable, sticky enable

# mpv's video window (music-search.py's play action, audio-only mode
# never creates a window at all) -- floating and centered rather than
# tiling into whatever workspace happened to be focused, same
# "utility popup, not a real workspace citizen" treatment nāda gets
# above. No blur here -- this is meant to be watched immediately.
# app_id confirmed directly (`swaymsg -t get_tree` while a real video
# was playing), not assumed from mpv's binary name.
#
# `focus` matters, not cosmetic: confirmed live that a window spawned
# this way (detached Popen from music-search.py, not from an already-
# focused terminal's own exec chain) does NOT get keyboard focus
# automatically in sway -- space/arrows/etc. silently went to whatever
# window was focused before, not to mpv, which is exactly "I can't
# control it" from the outside. Explicitly focusing here fixed it,
# verified via mpv's own IPC (`pause` property actually flipped after
# a spacebar press once focus was forced) before trusting it.
for_window [app_id="^mpv$"] floating enable, resize set 66 ppt 66 ppt, move position center, focus

# YouTube search (raga): two keys, one per way to play; inside, Shift+Enter
# plays the other way and Ctrl+M switches. Music plays in nāda (with
# YouTube's mix lined up after it); video opens in mpv (the for_window
# rule above focuses it).
#: Search YouTube and play a video (raga, in mpv)
bindsym $mod+Shift+y exec $vyom raga video

#: Search YouTube and play music (raga, in nāda)
bindsym $mod+Ctrl+Shift+y exec $vyom raga music

# Cycle notification mode (normal -> silent -> dnd -> normal) -- same
# script and same three-state cycle the waybar bell's scroll wheel uses
# (on-scroll-up/-down in waybar/config), just the keyboard path. Only
# one direction bound here since scroll already covers both, and
# cycling forward through 3 states by pressing repeatedly is simple
# enough not to need a second reverse-cycle keybinding to remember too.
#: Cycle notification mode (normal -> silent -> dnd)
bindsym $mod+n exec ~/.local/bin/notification-mode.sh next

# Direct jumps to a specific notification mode, alongside the cycle
# above -- for "I know exactly which mode I want right now" (DND before
# a meeting, say) rather than pressing $mod+n repeatedly and counting
# states.
#: Set notification mode to {}
bindsym $mod+Ctrl+n exec ~/.local/bin/notification-mode.sh normal
bindsym $mod+Ctrl+s exec ~/.local/bin/notification-mode.sh silent
bindsym $mod+Ctrl+d exec ~/.local/bin/notification-mode.sh dnd

# $mod+? matches the near-universal "show shortcuts" convention (Slack,
# Discord, GitHub, GNOME all use ? or Ctrl+/) rather than inventing a new
# one. Excludes Neovim on purpose -- it already has its own keymap search.
#: Search every keybinding on the system (mudra; Enter runs it)
bindsym $mod+Shift+slash exec $vyom mudra

### Window Look & Feel (Classy Minimalist)
# Core border style for windows
default_border pixel 2
default_floating_border pixel 2
font pango:JetBrainsMono Nerd Font 12

# --- Window Geometry (Margins / Gaps) ---
# Inner gaps separate adjacent windows from each other
gaps inner 4
# Outer gaps separate windows from the screen edges and Waybar
gaps outer 4
# inverse_outer (not plain "on"): outer (screen-edge) gaps show
# specifically when a workspace has exactly one window -- the common
# case -- so there's always a visible margin to the screen edge then.
# With multiple tiled windows, outer gaps hide (inner gaps between the
# windows still apply) so tiling doesn't waste edge space. Free either
# way: same gap calculation sway already does every frame.
smart_gaps inverse_outer

# Tried workspace_auto_back_and_forth (pressing the key for the workspace
# you're already on jumps back to whichever one you were on before, like
# alt-tab) -- reverted: pressing $mod+1 while already on workspace 1
# should just stay there, not silently toggle away to wherever you'd
# been previously. Sway's default (off) is what's wanted here.

# --- SwayFX Aesthetics (Rounded Corners & Shadows) ---
# Smooth corners that match the curvature of your Waybar pills
corner_radius 12
# Subtle drop-shadows to give windows separation from the wallpaper
shadows on
shadow_blur_radius 20
shadow_color #0000007F

# Real compositor-level background blur behind every Vyom panel (the
# launcher and system panels), via SwayFX's layer_effects (scenefx). This
# is what makes "glass" read as glass: the panels' translucent background
# has nothing real to blur behind it without this. Vyom's layer surfaces
# are all named "vyom". No blur_xray: it blurred only the wallpaper,
# so over a dark part a panel looked solid; without it the panel blurs
# the windows actually behind it, which always reads as glass.
# The card fills the surface exactly, so corner_radius is its CSS
# border-radius (vyom/style.css).
layer_effects "vyom" {
    blur enable
    corner_radius 20
    shadows enable
}

# History on this block: went blur+blur_xray+shadows -> reverted to
# corner_radius-only (read as "a window into the wallpaper" without
# wofi's supporting alpha/border tuning) -> back to blur+blur_xray now,
# explicitly matching wofi's own working recipe above (same blur
# mechanism, mako/config's background-color/border-color now at the same
# 0.85/0.55 alpha wofi uses, not a from-scratch guess this time).
#
# shadows still left off, unlike wofi's block above -- that part's a
# real, unrelated finding, not tuning to taste: with two notifications
# stacked directly against each other (mako has no between-notification
# gap setting), their individual soft shadows blend into one continuous
# dark halo behind the whole stack, reported directly as "a translucent
# container behind all the toasts". wofi only ever shows one window at a
# time, so its own shadow never hits this. corner_radius alone still
# gets real rounded corners with a clean edge, no shared halo.
#
# blur_xray dropped too -- ruled out by direct isolation testing as the
# cause of a second real bug (a separate sharp-cornered rectangle
# visible around the rounded card, reported as "the external
# container"): removing it alone didn't change that artifact at all, so
# it wasn't blur_xray specifically causing it (the real cause was
# mako/config's own margin -- see that file's own comment). Left off
# anyway now that it's not needed: plain `blur` already blurs whatever's
# genuinely behind the notification, which is the more honest behavior
# for a popup that can appear over any window, rather than blur_xray's
# "always blur the true desktop wallpaper regardless of what's actually
# behind" -- wofi wants that specifically since it's meant to look the
# same regardless of context; a notification appearing over whatever
# you're actually doing doesn't need that same guarantee.
#
# blur_ignore_transparent enable is the actual, complete fix for the
# margin-bleed bug mako/config's own comment describes in full -- mako
# leaves its margin area transparent (unfilled) in its own surface
# buffer, but without this flag SwayFX blurred that transparent area
# anyway, producing a visible sharp-cornered rectangle of blurred-but-
# untreated background outside the rounded card. This tells it to skip
# blurring transparent regions instead, so that area now shows the real,
# untouched background straight through -- confirmed directly at 700%
# zoom, at mako's original full 10/20 margin (restored from the smaller
# values tried as a stopgap before this flag was found): the rounded
# card's border is the true edge at any margin size, nothing bleeds past
# it.
layer_effects "notifications" {
    blur enable
    blur_ignore_transparent enable
    corner_radius 12
}

# --- Theme Window Borders ---
# Color configuration for window frames
# Focused border: Red. Went Mauve -> Sapphire -> Lavender -> Mauve before
# this -- asked for something more "dominant" than Mauve read as. Red is
# the single boldest, most commanding hue in this palette -- everywhere
# else in this setup it's reserved for real alerts (network disconnected,
# battery critical, the power button), which is a real trade-off worth
# naming: unlike those, this is a *persistent* fixture on every focused
# window, not a transient alert, and the two read differently enough in
# practice (a thin border outline vs. a whole waybar pill going red) that
# it shouldn't actually get mistaken for "something's wrong" -- but flag
# it if it ever does read that way.
# class                 border  bground text    indicator child_border
client.focused          #F38BA8 #11111B #CDD6F4 #F38BA8   #F38BA8
client.focused_inactive #45475A #1E1E2E #A6ADC8 #45475A   #45475A
client.unfocused        #313244 #1E1E2E #6C7086 #313244   #313244
# Urgent = danger red, the same as everywhere else in this setup.
client.urgent           #DC2626 #11111B #CDD6F4 #DC2626   #DC2626


### Wallpaper configuration
# Daily rotation is handled by systemd/.config/systemd/user/wallpaper.timer
# (fetch_wallpaper.sh) -- once a day, not on every reload. This just sets
# the background at sway startup/reload from whatever current.jpg already is.
output * bg ~/Pictures/Wallpapers/current.jpg fill

### Input configuration
input type:touchpad {
	tap enabled
		natural_scroll enabled
}

# No cursor theme was ever explicitly set anywhere (checked: not in env,
# not here, not in gtk-3.0/settings.ini) -- apps were left to each fall
# back to their own default resolution, inconsistently. "default" already
# resolves to Adwaita (/usr/share/icons/default/index.theme), just never
# told to anything explicitly. Real, worthwhile fix on its own regardless
# of any one app's cursor behavior.
seat seat0 xcursor_theme Adwaita 24

