# ------------------------------------------------------------------------------
# swaylock-effects — big left circle, works on any wallpaper
# ------------------------------------------------------------------------------

# --- Core ---
ignore-empty-password
disable-caps-lock-text

image=/home/yash/Pictures/Wallpapers/current.jpg
scaling=fill

indicator
clock

# --- Font ---
font="JetBrainsMono Nerd Font"
font-size=80

# --- Time & Date ---
timestr=%I:%M %p
datestr=%b %d  %A

# --- Indicator: big, pinned to the left ---
# x=400 keeps the circle center in the left third of most screens
# y=540 vertically centers it on 1080p (adjust to 720 for 1440p)
indicator-x-position=400
indicator-y-position=540
indicator-radius=280
indicator-thickness=4

# --- Inside: semi-dark frosted backdrop ---
# This is what makes it readable against ANY wallpaper.
# A dark translucent fill means the clock is always legible
# whether the photo behind is bright sky or dark mountains.
inside-color=1E1E2Ecc
inside-clear-color=1E1E2Ecc
inside-caps-lock-color=1E1E2Ecc
inside-ver-color=1E1E2Ecc
inside-wrong-color=1E1E2Ecc

# --- Ring: solid Catppuccin purple, full opacity ---
# ff = fully opaque so the ring has real presence
ring-color=CBA6F7ff
ring-clear-color=A6E3A1ff
ring-caps-lock-color=FAB387ff
ring-ver-color=89B4FAff
ring-wrong-color=DC2626ff

# --- Line: hidden ---
line-color=00000000
line-clear-color=00000000
line-caps-lock-color=00000000
line-ver-color=00000000
line-wrong-color=00000000

# --- Text: always white/light so it reads on the dark inside ---
text-color=CDD6F4ff
text-clear-color=A6E3A1ff
text-ver-color=89B4FAff
text-wrong-color=DC2626ff
text-caps-lock-color=FAB387ff

# --- Key highlights ---
key-hl-color=CBA6F7ff
bs-hl-color=F38BA8ff
caps-lock-key-hl-color=FAB387ff
caps-lock-bs-hl-color=F38BA8ff
