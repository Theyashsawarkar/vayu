#%PAM-1.0
# PAM for the greeter's own session (tuigreet, as user `greeter`): greetd
# uses this file over greetd when it exists. Same as pam.d/greetd minus
# pam_gnome_keyring, which otherwise started a keyring daemon for the
# greeter user with HOME=/ on every boot ("unable to create keyring dir:
# /.local/share/keyrings" in the journal).

auth       required     pam_securetty.so
auth       requisite    pam_nologin.so
auth       include      system-local-login
account    include      system-local-login
password   include      system-local-login
session    include      system-local-login
