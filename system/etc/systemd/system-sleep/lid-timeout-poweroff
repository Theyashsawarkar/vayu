#!/usr/bin/env bash
# Installed as /etc/systemd/system-sleep/lid-timeout-poweroff (root-owned,
# executable, NOT stow-managed -- system-sleep hooks only work from /etc)
# by system/apply.sh, which install.sh runs.
#
# Auto-poweroff if the lid stays closed for 30+ minutes straight.
#
# logind already suspends immediately on lid close
# (HandleLidSwitch=suspend, /etc/systemd/logind.conf) -- this hook rides
# on top of that instead of replacing it. Right before suspending
# ("pre"), it arms a hardware RTC wake alarm for TIMEOUT_SECONDS out: a
# plain suspend halts the CPU entirely, so a software timer
# (systemd-run --on-active, a cron job, anything userspace) would never
# fire on its own -- only a real RTC interrupt can wake genuinely-
# suspended hardware with nobody touching it.
#
# The lid has to stay closed for the whole time, across wakes: the
# moment it was first closed is kept in $ARMED (/run, so a reboot clears
# it). Each "pre" sets the RTC alarm for whatever is left of the timeout,
# not a fresh 30 minutes. Each "post" powers off only if the lid is still
# closed AND the timeout has really passed; anything that wakes it sooner
# with the lid shut (a USB keyboard, a dock, AC plugged in: last night it
# woke 5 times in 5 minutes) just lets logind suspend it again. Before,
# any such wake powered it off on the spot, unsaved work and all; it only
# didn't because the lid read "open" for a moment after resume.
#
# rtcwake -m no specifically: that mode only ARMS the wake alarm and
# returns immediately -- it does not itself put anything to sleep.
# logind is already independently handling the actual suspend
# transition; this hook just needs to set the alarm and get out of the
# way before the pre-hook's blocking window annoyingly delays sleep.
set -euo pipefail

CONF=/etc/lid-timeout-poweroff.conf
TIMEOUT_SECONDS=1800
DRY_RUN=0
# shellcheck source=/dev/null
[ -f "$CONF" ] && source "$CONF"

# The ACPI lid device's name varies by firmware (LID0 on the Acer, LID on
# the HP ProBook): take whichever one exists. Both overridable for tests.
LID_STATE_FILE=${LID_STATE_FILE:-$(ls /proc/acpi/button/lid/*/state 2>/dev/null | head -n1)}
ARMED=${LID_TIMEOUT_ARMED:-/run/lid-timeout-poweroff.armed}
log() { logger -t lid-timeout-poweroff -- "$*"; }
lid_closed() { [ -n "$LID_STATE_FILE" ] && grep -q closed "$LID_STATE_FILE" 2>/dev/null; }
now=$(date +%s)

case "${1:-}/${2:-}" in
  pre/suspend)
    # Keep the first close time while the lid stays shut across wakes.
    if ! [ -s "$ARMED" ] || ! lid_closed; then echo "$now" > "$ARMED"; fi
    since=$(cat "$ARMED")
    left=$(( TIMEOUT_SECONDS - (now - since) ))
    [ "$left" -lt 60 ] && left=60
    rtcwake -m no -s "$left" >/dev/null || log "rtcwake failed: no power-off timer"
    ;;
  post/suspend)
    if ! lid_closed; then
      rm -f "$ARMED"          # someone opened it: start over next time
      exit 0
    fi
    since=$(cat "$ARMED" 2>/dev/null || echo "$now")
    closed_for=$(( now - since ))
    if [ "$closed_for" -lt $(( TIMEOUT_SECONDS - 60 )) ]; then
      log "woke with the lid closed after ${closed_for}s (<${TIMEOUT_SECONDS}s): not powering off"
      exit 0
    fi
    rm -f "$ARMED"
    # logger (journal), not notify-send, is the reliable signal here:
    # systemd's own docs for this hook mechanism state user.slice is
    # frozen for the whole time these scripts run, and warn against
    # talking to user services that expect a reply -- exactly what a
    # D-Bus notify-send call to mako is. A journal entry has no such
    # dependency and always lands, dry run or real.
    log "lid closed for ${closed_for}s straight -- $([ "$DRY_RUN" = "1" ] && echo "DRY RUN, not powering off" || echo "powering off")"

    if [ "$DRY_RUN" = "1" ]; then
      # Best-effort only -- may not land if user.slice is still frozen
      # at this exact instant (see comment above). The logger line
      # above is the one guaranteed to work; check that if this
      # doesn't show up.
      user=$(loginctl list-sessions --no-legend 2>/dev/null | awk '$4=="seat0" {print $3; exit}')
      uid=$(id -u "${user:-nobody}" 2>/dev/null || echo 0)
      [ -n "$user" ] && sudo -u "$user" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
        notify-send -u critical -a "lid-timeout-poweroff" \
        -i /usr/share/icons/AdwaitaLegacy/48x48/legacy/dialog-warning.png \
        "DRY RUN: would power off" \
        "Lid was closed for ${closed_for}s straight -- this would be a real poweroff with DRY_RUN=0." \
        2>/dev/null || true
    else
      systemctl poweroff
    fi
    ;;
esac
