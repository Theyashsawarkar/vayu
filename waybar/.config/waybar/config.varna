{
	"layer": "top",
	"position": "top",
	"height": 41,
	"spacing": 8,

	// Left: where you are (workspaces with their apps, what's playing).
	// Middle: when (one capsule: notifications, time, date).
	// Right: the machine, from temporary to permanent: indicators that only
	// show while something is on (caps lock, hotspot, containers,
	// ekatva, jyoti), then connectivity, then CPU and RAM (colour only), then
	// volume, brightness and battery, then quick settings (which
	// also has the power menu and lock). Rare toggles (theme, wallpaper, DND, power profile...) live in
	// quick settings (vyom quick), not on the bar.
	"modules-left": ["sway/workspaces", "custom/nada"],
	"modules-center": ["custom/call", "group/clockbox"],
	"modules-right": [
		"custom/recording",
		"custom/capslock",
		"custom/hotspot",
		"custom/docker",
		"custom/ekatva",
		"custom/jyoti",
		"bluetooth",
		"group/connectivity",
		"cpu",
		"memory",
		"group/system",
		"custom/quick"
	],

	// Groups draw as one capsule (style.css: #clockbox, #connectivity,
	// #system: waybar names a group widget after it), modules inside
	// are plain segments (spacing only, no dividers).
	"group/clockbox": { "orientation": "horizontal", "modules": ["custom/notifications", "clock#time", "clock"] },
	"group/connectivity": { "orientation": "horizontal", "modules": ["network"] },
	"group/system": { "orientation": "horizontal", "modules": ["custom/volume", "backlight", "battery"] },

	"sway/workspaces": {
		"disable-scroll": true,
		"all-outputs": true,
		// The apps on each workspace as icons next to its number.
		"format": "{name}{windows}",
		"format-window-separator": "",
		"window-rewrite-default": "  \uf2d0",
		"window-rewrite": {
			"class<kitty|foot|Alacritty|org.wezfurlong.wezterm>": "  \uf489",
			"class<firefox|librewolf|zen>": "  󰈹",
			"class<chromium|google-chrome|brave-browser>": "  \uf268",
			"class<code|code-oss|Code|dev.zed.Zed|zed>": "  󰨞",
			"class<org.gnome.Nautilus|thunar|nemo|pcmanfm>": "  \uf07b",
			"class<discord|vesktop|Slack|slack>": "  󰭹",
			"class<Spotify|spotify|mpv|rmpc>": "  󰝚",
			"class<jetbrains-studio|android-studio>": "  󰀲",
			"class<libreoffice.*|soffice>": "  󰈙",
			"class<pavucontrol|org.pulseaudio.pavucontrol>": "  󰕾"
		},
		"persistent-workspaces": {
			"1": [],
			"2": [],
			"3": []
		}
	},


	"custom/capslock": {
		"exec": "$HOME/.local/bin/keylock-status.sh capslock",
		"on-click": "$HOME/.local/bin/keylock-toggle.sh capslock",
		"interval": "once",
		"signal": 9,
		"return-type": "json",
		"hide-empty-text": true
	},


	"clock": {
	// Date half. Time lives in a separate "clock#time" instance right next
	// to it -- waybar's clock format only accepts one {:...} placeholder
	// per module (confirmed: a second one throws "invalid arg-id in format
	// string"), so two colors means two module instances.
	"format": "{:%a %d %b}",
	"tooltip-format": "<tt><small>{calendar}</small></tt>"
	},

	// The phone's call in progress (ekatva), left of the bell: who, and for
	// how long (1h 20m). Hidden with no call. Click opens ekatva on Calls,
	// right click hangs up. One long-running watch, no polling.
	"custom/call": {
		"exec": "$HOME/.local/bin/ekatva call --waybar",
		"return-type": "json",
		"restart-interval": 5,
		"on-click": "$HOME/.local/bin/ekatva-open.sh calls",
		"on-click-right": "$HOME/.local/bin/ekatva call hangup"
	},

	"custom/notifications": {
		"exec": "cat \"$XDG_RUNTIME_DIR/vayu/bar/bell.json\" 2>/dev/null || $HOME/.local/bin/notification-history-status.sh",
		"interval": "once",
		"return-type": "json",
		"on-click": "$HOME/.local/bin/vyom akashvani",
		"on-scroll-up": "$HOME/.local/bin/notification-mode.sh next",
		"on-scroll-down": "$HOME/.local/bin/notification-mode.sh prev",
		"signal": 8
	},

	"clock#time": {
	"format": "{:%I:%M %p}",
	"tooltip": false
	},



	"custom/docker": {
		"exec": "cat \"$XDG_RUNTIME_DIR/vayu/bar/docker.json\" 2>/dev/null || $HOME/.local/bin/docker-status.sh",
		"interval": "once",
		"signal": 14,
		"return-type": "json",
		"on-click": "$HOME/.local/bin/vyom patra"
	},

	"network": {
		// Just the icon (Wi-Fi signal or the wired-network glyph); the network
		// name and IP are in the tooltip, the speed in the click panel (tarang).
		"format-wifi": "<span size='150%' rise='-2pt' color='{{text}}'>{icon}</span>",
		"format-ethernet": "<span size='150%' rise='-2pt' color='{{text}}'>󰌗</span>",
		"format-disconnected": "<span size='150%' rise='-2pt' color='{{red}}'>󰌘</span>",
		"format-disabled": "<span size='150%' rise='-2pt' color='{{red}}'>󰖪</span>",
		"format-linked": "<span size='150%' rise='-2pt' color='{{red}}'>󰌘</span>",
		"format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
		"interval": 30,
		"tooltip-format-wifi": "<span weight='bold' color='{{teal}}'>{essid}</span>\n<span color='{{subtext0}}'>Signal {signalStrength}%  ·  {frequency} GHz\nIP {ipaddr}/{cidr}  ·  gateway {gwaddr}</span>\n<span size='small' color='{{overlay1}}'>Click: Wi-Fi and hotspot</span>",
		"tooltip-format-ethernet": "<span weight='bold' color='{{teal}}'>Wired</span>  {ifname}\n<span color='{{subtext0}}'>IP {ipaddr}/{cidr}  ·  gateway {gwaddr}</span>\n<span size='small' color='{{overlay1}}'>Click: network panel</span>",
		"tooltip-format-disconnected": "<span weight='bold' color='{{red}}'>Disconnected</span>\n<span size='small' color='{{overlay1}}'>Click: pick a Wi-Fi network</span>",
		"tooltip-format-disabled": "<span weight='bold' color='{{red}}'>Wi-Fi is off</span>  (rfkill)\n<span size='small' color='{{overlay1}}'>Click: Wi-Fi panel</span>",
		"on-click": "$HOME/.local/bin/vyom tarang"
	},

	// Shown only while the hotspot (vayu-hotspot) is on: devices connected.
	// Only on bar-events' signal 15 (NetworkManager, `iw event`): a device
	// that vanishes without leaving is dropped by the access point after a
	// few idle minutes, which `iw event` reports too (it ran every 30 s).
	"custom/hotspot": {
		"exec": "$HOME/.local/bin/hotspot-status.sh",
		"interval": "once",
		"signal": 15,
		"return-type": "json",
		"on-click": "$HOME/.local/bin/vyom tarang hotspot",
		"on-click-right": "$HOME/.local/bin/vayu-hotspot off"
	},


	"backlight": {
		// Material brightness-5/6/7: a sun that fills as it gets
		// brighter (outline, half, full). Replaced circle-slice pies,
		// which read as a clock at low levels. 125% matches the volume
		// icon's weight next to it (this sun fills more of its box than
		// the speaker does, so 150% looked bigger); rise='-1pt' centres
		// it on the digits, measured from screenshots (2026-09-29).
		"format": "<span size='125%' rise='-1pt' color='{{text}}'>{icon}</span>  {percent}%",
		"format-icons": ["󰃞", "󰃟", "󰃠"],
		// No tooltip (2026-11-24): it popped up over the slider pop-up while
		// you scrolled. The value is on the capsule and in the pop-up.
		"tooltip": false,
		// No click (2026-11-26): scrolling does it, and kendra has the slider.
		"on-scroll-up": "$HOME/.config/sway/scripts/brightness_osd.sh +5%",
		"on-scroll-down": "$HOME/.config/sway/scripts/brightness_osd.sh 5%-",
		"smooth-scrolling-threshold": 1,
		"reverse-scrolling": true
	},

	"custom/volume": {
		// The sound capsule (2026-11-26): the icon follows the output
		// (earbuds, headphones, a speaker, the car, a TV, or the built-in
		// speakers by level), Bluetooth ones in blue, red when muted;
		// bar-events listens to the sound server (pactl subscribe), builds
		// the line with bar-volume's code and signals 17, so it changes the
		// moment the buds connect and a scroll step shows in ~15 ms; the exec
		// is a cat of its file (2026-11-27: no longer a second Python process
		// streaming it; `bar-volume --once` when bar-events isn't running).
		// Replaces "pulseaudio", which can't tell buds from headphones; same
		// size, centring, clicks and scroll.
		"exec": "cat \"$XDG_RUNTIME_DIR/vayu/bar/volume.json\" 2>/dev/null || $HOME/.local/bin/bar-volume --once",
		"return-type": "json",
		"interval": "once",
		"signal": 17,
		"escape": false,
		"on-click": "$HOME/.config/sway/scripts/volume_osd.sh mute-toggle",
		"on-click-right": "pavucontrol",
		"on-scroll-up": "$HOME/.config/sway/scripts/volume_osd.sh +5%",
		"on-scroll-down": "$HOME/.config/sway/scripts/volume_osd.sh -5%",
		"smooth-scrolling-threshold": 1,
		"reverse-scrolling": true
	},

	"pulseaudio": {
		// Icon at 150% (at 12px it read smaller than the brightness
		// icon beside it). rise='-2pt' keeps it centred on the digits:
		// without it the bigger glyph pushed the text 2 px down and the
		// icon sat 2 px above the text's middle (measured from
		// screenshots, 2026-09-29). An icon-only span was tried before
		// and "broke", but that was the threshold-object format-icons
		// bug below hiding the icon, not the span.
		"format": "<span size='150%' rise='-2pt' color='{{text}}'>{icon}</span>  {volume}%",
		"format-muted": "<span size='150%' rise='-2pt' color='{{red}}'>󰝟</span> 0%",
		// Plain array, NOT waybar's threshold-object form
		// ({"icon":...,"max":...}) -- that form is real and documented
		// (waybar's own man page and source, src/ALabel.cpp), and was
		// tried here specifically to give 0% its own icon separate from
		// "just quiet". Confirmed directly, by dumping the actual
		// rendered pixels as ASCII art rather than trusting color-based
		// sampling again (which had already misled two verifications in
		// a row on this exact feature) -- the threshold-object form
		// silently renders NO icon at all for the regular (non-muted)
		// pulseaudio format string in this waybar build (v0.15.0), while
		// the plain array it replaced works correctly. A real bug/
		// incompatibility in this version, not a config mistake -- filed
		// under "don't use" rather than fought further. The 0%-looks-
		// muted goal is handled at the source instead: volume_osd.sh
		// now sets PulseAudio's real mute flag whenever scrolling/
		// pressing down lands exactly on 0%, so format-muted above (the
		// one path already proven correct the whole time) picks it up
		// naturally, no dependence on the broken feature at all.
		"format-icons": {
			"default": ["󰕿", "󰖀", "󰕾"]
		},
		// No tooltip (2026-11-24): it popped up over the slider pop-up while
		// you scrolled. The value is on the capsule and in the pop-up.
		"tooltip": false,
		"on-click": "$HOME/.config/sway/scripts/volume_osd.sh mute-toggle",
		"on-click-right": "pavucontrol",
		"on-scroll-up": "$HOME/.config/sway/scripts/volume_osd.sh +5%",
		"on-scroll-down": "$HOME/.config/sway/scripts/volume_osd.sh -5%",
		"smooth-scrolling-threshold": 1,
		"reverse-scrolling": true
	},

	"cpu": {
		"interval": 5,
		"states": { "warning": 60, "critical": 85 },
		// How hard the machine is working (2026-11-24: a RAM-full freeze gave
		// no warning). Its own capsule, like memory's. Icon only, the colour is
		// the status (green, yellow from 60%, red from 85%: 2026-11-26); the numbers
		// are in the tooltip. The octicon chip (picked from a page of options,
		// ~/Documents/mockups/bar-icons). 150% so it reads at bar size.
		"format": "<span size='150%' rise='-2pt' color='{{green}}'>\uf4bc</span>",
		"format-warning": "<span size='150%' rise='-2pt' color='{{yellow}}'>\uf4bc</span>",
		"format-critical": "<span size='150%' rise='-2pt' color='{{red}}'>\uf4bc</span>",
		"tooltip-format": "<span weight='bold'>CPU</span>  {usage}%\n<span color='{{subtext0}}'>Load {load}  ·  {avg_frequency} GHz</span>\n<span size='small' color='{{overlay1}}'>Click: btop</span>",
		"on-click": "kitty --class dev.vayu.Btop -e btop -c ~/.local/state/varna/btop.conf"
	},

	"memory": {
		"interval": 5,
		"states": { "warning": 60, "critical": 85 },
		// A RAM stick, same rules as the CPU chip.
		"format": "<span size='150%' rise='-2pt' color='{{green}}'>\uefc5</span>",
		"format-warning": "<span size='150%' rise='-2pt' color='{{yellow}}'>\uefc5</span>",
		"format-critical": "<span size='150%' rise='-2pt' color='{{red}}'>\uefc5</span>",
		"tooltip-format": "<span weight='bold'>RAM</span>  {percentage}%\n<span color='{{subtext0}}'>{used:0.1f} of {total:0.1f} GiB  ·  swap {swapUsed:0.1f} of {swapTotal:0.1f} GiB</span>\n<span size='small' color='{{overlay1}}'>Click: btop</span>",
		"on-click": "kitty --class dev.vayu.Btop -e btop -c ~/.local/state/varna/btop.conf"
	},

	"bluetooth": {
		// Its own capsule, left of the network one, only while a device is
		// connected: just the icon; which device (and its battery) is in the
		// tooltip. On/off is in quick settings.
		"format-off": "",
		"format-on": "",
		"format-disabled": "",
		"format-connected": "<span size='125%' rise='-1pt' color='{{text}}'>󰂱</span>",
		"format-connected-battery": "<span size='125%' rise='-1pt' color='{{text}}'>󰂱</span>",
		"tooltip-format-connected": "{device_enumerate}",
		"tooltip-format-enumerate-connected": "{device_alias}",
		"tooltip-format-enumerate-connected-battery": "{device_alias}  {device_battery_percentage}%",
		"on-click": "$HOME/.local/bin/vyom setu"
	},

	// Shown only while recording (wf-recorder-toggle.sh); a click stops it.
	// Not polled: the toggle signals it every second while it records.
	"custom/recording": {
		"exec": "~/.local/bin/wf-recorder-status.sh",
		"on-click": "~/.local/bin/wf-recorder-toggle.sh",
		"interval": "once",
		"signal": 16,
		"return-type": "json"
	},

	// Shown only while ekatva (the phone link) is on: off by default, and the
	// on/off is remembered across reboots (ekatva-toggle.sh). Click opens it,
	// right click turns it off; quick settings has the switch.
	"custom/ekatva": {
		"exec": "cat \"$XDG_RUNTIME_DIR/vayu/bar/ekatva.json\" 2>/dev/null || $HOME/.local/bin/ekatva-status.sh",
		"interval": "once",
		"signal": 13,
		"return-type": "json",
		"on-click": "$HOME/.local/bin/ekatva-open.sh",
		"on-click-right": "$HOME/.local/bin/ekatva-toggle.sh off"
	},

	"custom/jyoti": {
		"exec": "cat \"$XDG_RUNTIME_DIR/vayu/bar/jyoti.json\" 2>/dev/null || $HOME/.local/bin/jyoti-status.sh",
		// Shown only while lit. Click: put it out. Right-click: switch
		// Akhaṇḍa <-> Nandādīpa (needs ekatva).
		"on-click": "~/.local/bin/jyoti-toggle.sh off",
		"on-click-right": "~/.local/bin/jyoti-toggle.sh switch",
		"interval": "once",
		"signal": 12,
		"return-type": "json"
	},

	"battery": {
		// Waybar re-reads the battery when something reads its uevent file:
		// battery-limit-watch.sh does that on the kernel's power_supply events,
		// so plugging in shows at once. This is only the fallback (the
		// percentage creeps a point every few minutes).
		"interval": 60,
		"tooltip-format": "<span weight='bold' color='{{green}}'>Battery</span>  {capacity}%\n<span color='{{subtext0}}'>{timeTo}</span>",
		"tooltip-format-discharging": "<span weight='bold' color='{{green}}'>Battery</span>  {capacity}%\n<span color='{{subtext0}}'>{time} left  ·  using {power:.1f} W</span>",
		"tooltip-format-charging": "<span weight='bold' color='{{green}}'>Battery</span>  {capacity}%\n<span color='{{subtext0}}'>Charging  ·  {time} to full</span>",
		"tooltip-format-plugged": "<span weight='bold' color='{{green}}'>Battery</span>  {capacity}%\n<span color='{{subtext0}}'>Plugged in, not charging</span>",
		"tooltip-format-full": "<span weight='bold' color='{{green}}'>Battery</span>  {capacity}%\n<span color='{{subtext0}}'>Full, on the charger</span>",
		"states": {
			"critical": 15,
			"warning": 30,
			"moderate": 60
		},
		"format": "<span color='{{text}}'>{icon}</span>  {capacity}%",
		"format-charging": "<span color='{{peach}}'>{icon}</span>  {capacity}%",
		"format-plugged": "<span color='{{peach}}'>{icon}</span>  {capacity}%",
		"format-full": "<span color='{{text}}'>{icon}</span>  {capacity}%",
		"format-warning": "<span color='{{yellow}}'>{icon}</span>  {capacity}%",
		"format-critical": "<span color='{{red}}'>{icon}</span>  {capacity}%",
		"format-icons": {
			"charging": ["󰢜", "󰂈", "󰂉", "󰂊", "󰂅"],
			"plugged": ["󰢜", "󰂈", "󰂉", "󰂊", "󰂅"],
			"full": ["󰂅"],
			"default": ["󰁺", "󰁽", "󰁿", "󰂁", "󰁹"]
		},
		"on-click": "$HOME/.local/bin/vyom urja"
	},


	// Now playing (MPD, played through rmpc). Hidden when stopped.
	// What's playing (nāda), right after the workspaces: moving bars and the
	// title while playing, still bars when paused, gone when nothing plays,
	// a progress ring while a YouTube song downloads. `nada waybar` streams
	// it (MPD idle events, so it changes the moment the song does).
	"custom/nada": {
		"exec": "$HOME/.local/bin/nada waybar",
		"return-type": "json",
		"escape": false,
		"on-click": "$HOME/.local/bin/nada ctl toggle",
		"on-click-middle": "$HOME/.local/bin/nada ctl next",
		"on-click-right": "$HOME/.local/bin/nada",
		"on-scroll-up": "$HOME/.local/bin/nada ctl seek +10",
		"on-scroll-down": "$HOME/.local/bin/nada ctl seek -10"
	},
	// Quick settings (Vyom): Wi-Fi, Bluetooth, hotspot, DND, jyoti,
	// theme, wallpaper, power profile, volume, brightness, lock, power.
	"custom/quick": {
		"format": "󰒓",
		"tooltip-format": "<span weight='bold' color='{{pink}}'>Quick settings</span>\n<span size='small' color='{{overlay1}}'>Click: open</span>",
		"on-click": "$HOME/.local/bin/vyom kendra"
	}

}
