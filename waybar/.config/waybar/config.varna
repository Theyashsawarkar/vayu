{
	"layer": "top",
	"position": "top",
	"height": 41,
	"spacing": 8,

	// Left: where you are (workspaces with their apps, what's playing).
	// Middle: when (one capsule: notifications, time, date).
	// Right: the machine, from temporary to permanent: indicators that only
	// show while something is on (caps lock, hotspot, containers, phone,
	// caffeine), then connectivity, then system, then quick settings (which
	// also has the power menu and lock). Rare toggles (theme, wallpaper, DND, power profile...) live in
	// quick settings (vyom quick), not on the bar.
	"modules-left": ["sway/workspaces", "custom/nada"],
	"modules-center": ["group/clockbox"],
	"modules-right": [
		"custom/capslock",
		"custom/hotspot",
		"custom/docker",
		"custom/phone",
		"custom/caffeine",
		"group/connectivity",
		"group/system",
		"custom/quick"
	],

	// Groups draw as one capsule (style.css: #clockbox, #connectivity,
	// #system: waybar names a group widget after it), modules inside
	// are plain segments (spacing only, no dividers).
	"group/clockbox": { "orientation": "horizontal", "modules": ["custom/notifications", "clock#time", "clock"] },
	"group/connectivity": { "orientation": "horizontal", "modules": ["network", "bluetooth", "network#speed"] },
	"group/system": { "orientation": "horizontal", "modules": ["pulseaudio", "backlight", "battery"] },

	"sway/workspaces": {
		"disable-scroll": true,
		"all-outputs": true,
		// The apps on each workspace as icons next to its number.
		"format": "{name}{windows}",
		"format-window-separator": "",
		"window-rewrite-default": "  \uf2d0",
		"window-rewrite": {
			"class<kitty|foot|Alacritty|org.wezfurlong.wezterm>": "  \uf489",
			"class<firefox|librewolf|zen>": "  󰈹",
			"class<chromium|google-chrome|brave-browser>": "  \uf268",
			"class<code|code-oss|Code|dev.zed.Zed|zed>": "  󰨞",
			"class<org.gnome.Nautilus|thunar|nemo|pcmanfm>": "  \uf07b",
			"class<discord|vesktop|Slack|slack>": "  󰭹",
			"class<Spotify|spotify|mpv|rmpc>": "  󰝚",
			"class<jetbrains-studio|android-studio>": "  󰀲",
			"class<org.kde.kdeconnect.*>": "  󰄜",
			"class<libreoffice.*|soffice>": "  󰈙",
			"class<pavucontrol|org.pulseaudio.pavucontrol>": "  󰕾"
		},
		"persistent-workspaces": {
			"1": [],
			"2": [],
			"3": []
		}
	},

	"backlight": {
		// Material brightness-5/6/7: a sun that fills as it gets
		// brighter (outline, half, full). Replaced circle-slice pies,
		// which read as a clock at low levels. 125% matches the volume
		// icon's weight next to it (this sun fills more of its box than
		// the speaker does, so 150% looked bigger); rise='-1pt' centres
		// it on the digits, measured from screenshots (2026-09-29).
		"format": "<span size='125%' rise='-1pt' color='{{accent}}'>{icon}</span>  {percent}%",
		"format-icons": ["󰃞", "󰃟", "󰃠"],
		"tooltip-format": "Click: drag to set   Scroll: +/-5%",
		"on-click": "$HOME/.local/bin/brightness-slider.sh",
		"on-scroll-up": "$HOME/.config/sway/scripts/brightness_osd.sh +5%",
		"on-scroll-down": "$HOME/.config/sway/scripts/brightness_osd.sh 5%-",
		"smooth-scrolling-threshold": 1,
		"reverse-scrolling": true
	},

	"custom/capslock": {
		"exec": "$HOME/.local/bin/keylock-status.sh capslock",
		"on-click": "$HOME/.local/bin/keylock-toggle.sh capslock",
		"interval": "once",
		"signal": 9,
		"return-type": "json",
		"hide-empty-text": true
	},


	"clock": {
	// Date half. Time lives in a separate "clock#time" instance right next
	// to it -- waybar's clock format only accepts one {:...} placeholder
	// per module (confirmed: a second one throws "invalid arg-id in format
	// string"), so two colors means two module instances, same pattern as
	// network/network#speed.
	"format": "{:%a %d %b}",
	"tooltip-format": "<tt><small>{calendar}</small></tt>"
	},

	"custom/notifications": {
		"exec": "$HOME/.local/bin/notification-history-status.sh",
		"interval": "once",
		"return-type": "json",
		"on-click": "$HOME/.local/bin/vyom suchana",
		"on-scroll-up": "$HOME/.local/bin/notification-mode.sh next",
		"on-scroll-down": "$HOME/.local/bin/notification-mode.sh prev",
		"signal": 8
	},

	"clock#time": {
	"format": "{:%I:%M %p}",
	"tooltip": false
	},



	"custom/docker": {
		"exec": "$HOME/.local/bin/docker-status.sh",
		"interval": "once",
		"signal": 14,
		"return-type": "json",
		"on-click": "$HOME/.local/bin/vyom patra"
	},

	"network": {
		// Just the icon (Wi-Fi signal or the wired-network glyph), then the
		// speed next to it; the network name and IP are in the tooltip.
		"format-wifi": "<span size='150%' rise='-2pt' color='{{accent}}'>{icon}</span> ",
		"format-ethernet": "<span size='150%' rise='-2pt' color='{{accent}}'>󰌗</span> ",
		"format-disconnected": "<span size='150%' rise='-2pt' color='{{red}}'>󰌘</span> ",
		"format-disabled": "<span size='150%' rise='-2pt' color='{{red}}'>󰖪</span> ",
		"format-linked": "<span size='150%' rise='-2pt' color='{{red}}'>󰌘</span> ",
		"format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
		"interval": 30,
		"tooltip-format-wifi": "{essid}\nSignal: {signalStrength}%  ({signaldBm} dBm)\nFrequency: {frequency} GHz\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}",
		"tooltip-format-ethernet": "{ifname}\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}",
		"tooltip-format-disconnected": "Disconnected",
		"tooltip-format-disabled": "Wi-Fi disabled (rfkill)",
		"on-click": "$HOME/.local/bin/vyom tarang"
	},

	// Shown only while the hotspot (vayu-hotspot) is on: devices connected.
	"custom/hotspot": {
		"exec": "$HOME/.local/bin/hotspot-status.sh",
		"interval": 30,
		"signal": 15,
		"return-type": "json",
		"on-click": "$HOME/.local/bin/vyom tarang hotspot",
		"on-click-right": "$HOME/.local/bin/vayu-hotspot off"
	},

	"network#speed": {
		"interval": 2,
		// Fixed-width values (monospace): the capsule never jitters as the
		// numbers change length, without a min-width that left a gap.
		"format": "<span color='{{accent}}'>\uf063</span>{bandwidthDownBytes:<8} <span color='{{accent}}'>\uf062</span>{bandwidthUpBytes:<8}",
		"tooltip": false
	},

	"bluetooth": {
		// Only a connected device shows here; on/off is in quick settings.
		"format-off": "",
		"format-on": "",
		"format-disabled": "",
		"format-connected": "  {device_alias}",
		"format-connected-battery": "  {device_alias}  {device_battery_percentage}%",
		"tooltip-format": "Bluetooth Status: {status}",
		"on-click": "$HOME/.local/bin/vyom setu",
		"max-length": 25
	},

	"custom/phone": {
		"exec": "$HOME/.local/bin/phone-status.sh",
		"interval": "once",
		"signal": 13,
		"return-type": "json",
		"on-click": "$HOME/.local/bin/vyom doot"
	},

	"custom/caffeine": {
		"exec": "~/.local/bin/caffeine-status.sh",
		"on-click": "~/.local/bin/caffeine-toggle.sh",
		"interval": "once",
		"signal": 12,
		"return-type": "json"
	},

	"battery": {
		"states": {
			"critical": 15,
			"warning": 30,
			"moderate": 60
		},
		"format": "<span color='{{accent}}'>{icon}</span>  {capacity}%",
		"format-charging": "<span color='{{accent}}'>{icon}</span>  {capacity}%",
		"format-plugged": "<span color='{{accent}}'>{icon}</span>  {capacity}%",
		"format-icons": {
			"charging": ["󰢜", "󰂈", "󰂉", "󰂊", "󰂅"],
			"default": ["󰁺", "󰁽", "󰁿", "󰂁", "󰁹"]
		},
		"on-click": "$HOME/.local/bin/vyom urja"
	},

	"pulseaudio": {
		// Icon at 150% (at 12px it read smaller than the brightness
		// icon beside it). rise='-2pt' keeps it centred on the digits:
		// without it the bigger glyph pushed the text 2 px down and the
		// icon sat 2 px above the text's middle (measured from
		// screenshots, 2026-09-29). An icon-only span was tried before
		// and "broke", but that was the threshold-object format-icons
		// bug below hiding the icon, not the span.
		"format": "<span size='150%' rise='-2pt' color='{{accent}}'>{icon}</span>  {volume}%",
		"format-muted": "<span size='150%' rise='-2pt' color='{{red}}'>󰝟</span>  Muted",
		// Plain array, NOT waybar's threshold-object form
		// ({"icon":...,"max":...}) -- that form is real and documented
		// (waybar's own man page and source, src/ALabel.cpp), and was
		// tried here specifically to give 0% its own icon separate from
		// "just quiet". Confirmed directly, by dumping the actual
		// rendered pixels as ASCII art rather than trusting color-based
		// sampling again (which had already misled two verifications in
		// a row on this exact feature) -- the threshold-object form
		// silently renders NO icon at all for the regular (non-muted)
		// pulseaudio format string in this waybar build (v0.15.0), while
		// the plain array it replaced works correctly. A real bug/
		// incompatibility in this version, not a config mistake -- filed
		// under "don't use" rather than fought further. The 0%-looks-
		// muted goal is handled at the source instead: volume_osd.sh
		// now sets PulseAudio's real mute flag whenever scrolling/
		// pressing down lands exactly on 0%, so format-muted above (the
		// one path already proven correct the whole time) picks it up
		// naturally, no dependence on the broken feature at all.
		"format-icons": {
			"default": ["󰕿", "󰖀", "󰕾"]
		},
		"tooltip-format": "Click: mute/unmute   Right-click: mixer   Scroll: +/-5%",
		"on-click": "$HOME/.config/sway/scripts/volume_osd.sh mute-toggle",
		"on-click-right": "pavucontrol",
		"on-scroll-up": "$HOME/.config/sway/scripts/volume_osd.sh +5%",
		"on-scroll-down": "$HOME/.config/sway/scripts/volume_osd.sh -5%",
		"smooth-scrolling-threshold": 1,
		"reverse-scrolling": true
	},

	// Now playing (MPD, played through rmpc). Hidden when stopped.
	// What's playing (nāda), right after the workspaces: moving bars and the
	// title while playing, still bars when paused, gone when nothing plays,
	// a progress ring while a YouTube song downloads. `nada waybar` streams
	// it (MPD idle events, so it changes the moment the song does).
	"custom/nada": {
		"exec": "$HOME/.local/bin/nada waybar",
		"return-type": "json",
		"escape": false,
		"on-click": "$HOME/.local/bin/nada ctl toggle",
		"on-click-middle": "$HOME/.local/bin/nada ctl next",
		"on-click-right": "$HOME/.local/bin/nada",
		"on-scroll-up": "$HOME/.local/bin/nada ctl seek +10",
		"on-scroll-down": "$HOME/.local/bin/nada ctl seek -10"
	},
	// Quick settings (Vyom): Wi-Fi, Bluetooth, hotspot, DND, caffeine,
	// theme, wallpaper, power profile, volume, brightness, lock, power.
	"custom/quick": {
		"format": "󰒓",
		"tooltip-format": "Quick settings",
		"on-click": "$HOME/.local/bin/vyom kendra"
	}

}
