{
	"layer": "top",
	"position": "top",
	"height": 41,
	"spacing": 8,

	"modules-center": ["custom/notifications", "clock#time", "clock"],
	"modules-left": ["sway/workspaces", "bluetooth", "network", "network#speed"],

	"modules-right": [
		"custom/capslock",
		"custom/numlock",
		"custom/theme",
		"custom/wallpaper",
		"custom/docker",
		"custom/phone",
		"custom/caffeine",
		"backlight",
		"pulseaudio",
		"battery",
		"custom/power"
	],

	"sway/workspaces": {
		"disable-scroll": true,
		"all-outputs": true,
		"format": "{name}",
		"persistent-workspaces": {
			"1": [],
			"2": [],
			"3": []
		}
	},

	"backlight": {
		// Material brightness-5/6/7: a sun that fills as it gets
		// brighter (outline, half, full). Replaced circle-slice pies,
		// which read as a clock at low levels. 125% matches the volume
		// icon's weight next to it (this sun fills more of its box than
		// the speaker does, so 150% looked bigger); rise='-1pt' centres
		// it on the digits, measured from screenshots (2026-09-29).
		"format": "<span size='125%' rise='-1pt'>{icon}</span>  {percent}%",
		"format-icons": ["󰃞", "󰃟", "󰃠"],
		"tooltip-format": "Click: drag to set   Scroll: +/-5%",
		"on-click": "/home/yash/.local/bin/brightness-slider.sh",
		"on-scroll-up": "/home/yash/.config/sway/scripts/brightness_osd.sh +5%",
		"on-scroll-down": "/home/yash/.config/sway/scripts/brightness_osd.sh 5%-",
		"smooth-scrolling-threshold": 1,
		"reverse-scrolling": true
	},

	"custom/capslock": {
		"exec": "/home/yash/.local/bin/keylock-status.sh capslock",
		"on-click": "/home/yash/.local/bin/keylock-toggle.sh capslock",
		"interval": 30,
		"signal": 9,
		"return-type": "json",
		"hide-empty-text": true
	},

	"custom/numlock": {
		"exec": "/home/yash/.local/bin/keylock-status.sh numlock",
		"on-click": "/home/yash/.local/bin/keylock-toggle.sh numlock",
		"interval": 30,
		"signal": 10,
		"return-type": "json",
		"hide-empty-text": true
	},

	"clock": {
	// Date half. Time lives in a separate "clock#time" instance right next
	// to it -- waybar's clock format only accepts one {:...} placeholder
	// per module (confirmed: a second one throws "invalid arg-id in format
	// string"), so two colors means two module instances, same pattern as
	// network/network#speed.
	"format": "  {:%a, %B %d}",
	"tooltip-format": "<tt><small>{calendar}</small></tt>"
	},

	"custom/notifications": {
		"exec": "/home/yash/.local/bin/notification-history-status.sh",
		"interval": 10,
		"return-type": "json",
		"on-click": "/home/yash/.local/bin/notification-history.py",
		"on-scroll-up": "/home/yash/.local/bin/notification-mode.sh next",
		"on-scroll-down": "/home/yash/.local/bin/notification-mode.sh prev",
		"signal": 8
	},

	"clock#time": {
	"format": "{:%I:%M %p}",
	"tooltip": false
	},

	"custom/theme": {
		"exec": "/home/yash/.local/bin/theme-status.sh",
		"interval": 60,
		"signal": 11,
		"return-type": "json",
		"on-click": "/home/yash/.local/bin/theme-toggle.sh"
	},

	"custom/wallpaper": {
		"format": "",
		"tooltip-format": "Click to fetch a new wallpaper",
		"on-click": "/home/yash/.local/bin/fetch_wallpaper.sh"
	},

	"custom/docker": {
		"exec": "/home/yash/.local/bin/docker-status.sh",
		"interval": 10,
		"return-type": "json",
		"on-click": "/home/yash/.local/bin/docker-picker.py"
	},

	"network": {
		"format-wifi": "{icon}  {essid}",
		"format-ethernet": "  {ipaddr}",
		"format-disconnected": "  Offline",
		"format-disabled": "  Disabled",
		"format-linked": "  No IP",
		"format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
		"interval": 2,
		"max-length": 30,
		"tooltip-format-wifi": "{essid}\nSignal: {signalStrength}%  ({signaldBm} dBm)\nFrequency: {frequency} GHz\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}",
		"tooltip-format-ethernet": "{ifname}\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}",
		"tooltip-format-disconnected": "Disconnected",
		"tooltip-format-disabled": "Wi-Fi disabled (rfkill)",
		"on-click": "/home/yash/.local/bin/wifi-picker.py"
	},

	"network#speed": {
		"interval": 2,
		"format": "<span color='#A6E3A1'> {bandwidthDownBytes}</span>  <span color='#FAB387'> {bandwidthUpBytes}</span>",
		"tooltip": false
	},

	"bluetooth": {
		"format-off": "",
		"format-on": "",
		"format-connected": "  {device_alias}",
		"format-connected-battery": "  {device_alias}  {device_battery_percentage}%",
		"tooltip-format": "Bluetooth Status: {status}",
		"on-click": "/home/yash/.local/bin/bluetooth-picker.py",
		"max-length": 25
	},

	"custom/phone": {
		"exec": "/home/yash/.local/bin/phone-status.sh",
		"interval": 60,
		"signal": 13,
		"return-type": "json",
		"on-click": "/home/yash/.local/bin/toggle-popup.sh phone wofi /home/yash/.local/bin/phone-picker.py"
	},

	"custom/caffeine": {
		"exec": "~/.local/bin/caffeine-status.sh",
		"on-click": "~/.local/bin/caffeine-toggle.sh",
		"interval": 60,
		"signal": 12,
		"return-type": "json"
	},

	"battery": {
		"states": {
			"critical": 15,
			"warning": 30,
			"moderate": 60
		},
		"format": "{icon}  {capacity}%",
		"format-charging": "{icon}  {capacity}%",
		"format-plugged": "{icon}  {capacity}%",
		"format-icons": {
			"charging": ["󰢜", "󰂈", "󰂉", "󰂊", "󰂅"],
			"default": ["󰁺", "󰁽", "󰁿", "󰂁", "󰁹"]
		},
		"on-click": "/home/yash/.local/bin/battery-limit-picker.py"
	},

	"pulseaudio": {
		// Icon at 150% (at 12px it read smaller than the brightness
		// icon beside it). rise='-2pt' keeps it centred on the digits:
		// without it the bigger glyph pushed the text 2 px down and the
		// icon sat 2 px above the text's middle (measured from
		// screenshots, 2026-09-29). An icon-only span was tried before
		// and "broke", but that was the threshold-object format-icons
		// bug below hiding the icon, not the span.
		"format": "<span size='150%' rise='-2pt'>{icon}</span>  {volume}%",
		"format-muted": "<span size='150%' rise='-2pt'>󰝟</span>  Muted",
		// Plain array, NOT waybar's threshold-object form
		// ({"icon":...,"max":...}) -- that form is real and documented
		// (waybar's own man page and source, src/ALabel.cpp), and was
		// tried here specifically to give 0% its own icon separate from
		// "just quiet". Confirmed directly, by dumping the actual
		// rendered pixels as ASCII art rather than trusting color-based
		// sampling again (which had already misled two verifications in
		// a row on this exact feature) -- the threshold-object form
		// silently renders NO icon at all for the regular (non-muted)
		// pulseaudio format string in this waybar build (v0.15.0), while
		// the plain array it replaced works correctly. A real bug/
		// incompatibility in this version, not a config mistake -- filed
		// under "don't use" rather than fought further. The 0%-looks-
		// muted goal is handled at the source instead: volume_osd.sh
		// now sets PulseAudio's real mute flag whenever scrolling/
		// pressing down lands exactly on 0%, so format-muted above (the
		// one path already proven correct the whole time) picks it up
		// naturally, no dependence on the broken feature at all.
		"format-icons": {
			"default": ["󰕿", "󰖀", "󰕾"]
		},
		"tooltip-format": "Click: mute/unmute   Right-click: mixer   Scroll: +/-5%",
		"on-click": "/home/yash/.config/sway/scripts/volume_osd.sh mute-toggle",
		"on-click-right": "pavucontrol",
		"on-scroll-up": "/home/yash/.config/sway/scripts/volume_osd.sh +5%",
		"on-scroll-down": "/home/yash/.config/sway/scripts/volume_osd.sh -5%",
		"smooth-scrolling-threshold": 1,
		"reverse-scrolling": true
	},

	"custom/power": {
		"format": "",
		"tooltip": false,
		"on-click": "nwg-bar -i 40"
	}
}
