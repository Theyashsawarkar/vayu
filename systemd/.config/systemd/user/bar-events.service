[Unit]
StartLimitIntervalSec=0
Description=Bar events -> waybar/tmux capsule refreshes (no polling)
Documentation=file://%h/.local/bin/bar-events.py
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/bar-events.py
Restart=always
RestartSec=2
# Back off (2 s up to 60 s) instead of hitting the start limit and staying
# dead: a quick repeated failure at login killed a unit for the session.
RestartSteps=5
RestartMaxDelaySec=60

# No [Install]: started from sway's config right after waybar, like
# phone-events.service, so it lives and dies with the sway session.
