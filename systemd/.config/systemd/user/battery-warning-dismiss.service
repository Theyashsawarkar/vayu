[Unit]
StartLimitIntervalSec=0
Description=Silently dismiss a stuck batsignal warning when AC power is restored

[Service]
Type=simple
ExecStart=%h/.local/bin/battery-warning-dismiss.sh
Restart=on-failure
RestartSec=2
# Back off (2 s up to 60 s) instead of hitting the start limit and staying
# dead: a quick repeated failure at login killed a unit for the session.
RestartSteps=5
RestartMaxDelaySec=60

[Install]
WantedBy=default.target
