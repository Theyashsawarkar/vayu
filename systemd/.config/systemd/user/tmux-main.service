# Not named tmux.service: tmux-continuum, with @continuum-boot off, runs
# `systemctl --user disable tmux.service` on every tmux server start, and
# disabling a symlinked unit file deletes the symlink -- that is how the
# stow link kept vanishing after each login.
[Unit]
Description=tmux default session (detached)
Documentation=man:tmux(1)

[Service]
Type=forking
Environment=DISPLAY=:0
ExecStart=/usr/bin/tmux new-session -d -s main

ExecStop=/home/yash/.tmux/plugins/tmux-resurrect/scripts/save.sh quiet
ExecStop=/usr/bin/tmux kill-server
KillMode=control-group

RestartSec=2

[Install]
WantedBy=default.target
