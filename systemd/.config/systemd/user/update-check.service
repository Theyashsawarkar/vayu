[Unit]
Description=Check for Vayu dotfiles updates on GitHub, prompt to apply
# Runs once per sway login, not at boot. The user manager lingers, so
# default.target is reached at boot, before anyone logs in: the check ran
# with no sway for its notification/nwg-bar prompt, and ~4 s before Wi-Fi
# was up, so 32 of 37 runs failed ("Could not resolve hostname"). The
# user manager's network-online.target doesn't track the real network,
# so update-check.sh waits for NetworkManager itself (nm-online).
After=graphical-session.target
PartOf=graphical-session.target

[Service]
# exec, not oneshot: the check can wait for the network and then sit on
# the prompt; nothing should wait for it to finish.
Type=exec
ExecStart=%h/.local/bin/update-check.sh

[Install]
WantedBy=sway-session.target
