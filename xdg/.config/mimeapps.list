[Default Applications]
# Web: one browser, Chrome, for every link and HTML page (it was split
# between Chrome, Zen and Brave depending on the type).
text/html=google-chrome.desktop
application/xhtml+xml=google-chrome.desktop
application/x-extension-htm=google-chrome.desktop
application/x-extension-html=google-chrome.desktop
application/x-extension-shtml=google-chrome.desktop
application/x-extension-xhtml=google-chrome.desktop
application/x-extension-xht=google-chrome.desktop
x-scheme-handler/http=google-chrome.desktop
x-scheme-handler/https=google-chrome.desktop
x-scheme-handler/about=google-chrome.desktop
x-scheme-handler/unknown=google-chrome.desktop
x-scheme-handler/chrome=google-chrome.desktop
x-scheme-handler/claude-cli=claude-code-url-handler.desktop
x-scheme-handler/bruno=bruno.desktop
# Documents: zathura (vim keys, themed by varna), not a browser.
application/pdf=darshan.desktop
application/epub+zip=org.pwmt.zathura.desktop
application/oxps=org.pwmt.zathura.desktop
application/vnd.ms-xpsdocument=org.pwmt.zathura.desktop
# Images: swayimg (light, Wayland-native, vim-ish keys), not a browser.
image/jpeg=darshan.desktop
image/png=darshan.desktop
image/gif=darshan.desktop
image/webp=darshan.desktop
image/bmp=darshan.desktop
image/tiff=swayimg.desktop
image/avif=swayimg.desktop
image/heic=swayimg.desktop
image/svg+xml=swayimg.desktop
image/x-icon=swayimg.desktop
# Videos and stream playlists (HLS): drishya, the video player.
video/mp4=dev.vayu.Drishya.desktop
video/x-matroska=dev.vayu.Drishya.desktop
video/webm=dev.vayu.Drishya.desktop
video/quicktime=dev.vayu.Drishya.desktop
video/x-msvideo=dev.vayu.Drishya.desktop
video/mpeg=dev.vayu.Drishya.desktop
video/mp2t=dev.vayu.Drishya.desktop
application/vnd.apple.mpegurl=dev.vayu.Drishya.desktop
application/x-mpegurl=dev.vayu.Drishya.desktop
# Audio files: mpv (quick, no window to manage).
audio/mpeg=mpv.desktop
audio/flac=mpv.desktop
audio/ogg=mpv.desktop
audio/x-opus+ogg=mpv.desktop
audio/x-wav=mpv.desktop
# Folders: a kitty window there (kitty-open).
inode/directory=kitty-open.desktop
