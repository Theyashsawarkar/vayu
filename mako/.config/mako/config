# ~/.config/mako/config

# --- Geometry & Positioning ---
# Anchors alerts to the top right corner, perfectly clear of the Waybar pills
anchor=top-right
#
# margin real bug, found and properly root-caused across several
# reports ("the external container" on the right, then again on top,
# then background "overflowing from the right" once margin was widened
# back out): mako bakes its margin INTO the surface's own pixel buffer
# rather than requesting true empty space outside a tightly-sized
# surface via the layer-shell protocol's own margin fields -- confirmed
# directly via `swaymsg -t get_outputs`, e.g. a configured `width=420`
# with margin-right 20 reported a real surface extent of 440. SwayFX's
# `corner_radius`/`blur` in sway/config's layer_effects operate on that
# FULL rectangular surface, so without the fix below they were rounding
# and blurring a 440-wide rectangle while mako's own rounded/tinted/
# bordered card only actually draws across the left 420 -- the other
# 20px sat there as a plain sharp-cornered strip of blurred-but-
# untreated background, the reported "container"/"overflow".
#
# The real fix is `blur_ignore_transparent enable` in sway/config's
# `layer_effects "notifications"` block, not a smaller margin number --
# tried shrinking margin first (down to 2/10, whatever value made the
# bleed small enough to not be visible at normal scale) before finding
# that option, and it was a real trade-off every time: less bleed always
# meant less actual gap from the screen edge, never both. With
# `blur_ignore_transparent` telling SwayFX to skip blurring mako's own
# transparent (unfilled) margin area instead of blurring it anyway, that
# area now shows the real, sharp, untouched background -- confirmed
# directly, zoomed to 700%, at this full 10/20 margin (back to the
# original comfortable values): the rounded card's own border is the
# true edge, nothing bleeds past it regardless of margin size.
margin=10,20,0,0
# width is a fixed value (mako's own docs: no shrink-to-fit); height is
# a *maximum*, shrunk to fit shorter text -- confirmed directly (man
# mako(5)). That combination is exactly why these looked square-ish:
# most everyday notifications here are short (1-2 lines), so height
# was already shrinking well below its old 150px cap while width sat
# fixed at 350 regardless -- reads as a boxier shape than the raw
# numbers alone suggest, especially with a 48px icon eating into the
# narrower content column. Widened to 420 and capped height lower at
# 130 (still generous for a wrapped 3-4 line body) so the box reads as
# a clear horizontal toast across the actual range of real notification
# lengths this desktop's scripts send, not just in the numeric ratio.
width=420
height=130
border-size=2
border-radius=12
padding=15

# --- Typography ---
font=JetBrainsMono Nerd Font 12
markup=1
#
# Plain again, no span/background wrapping -- explicitly reverted. Two
# rounds tried layering a second tinted panel behind the text specifically
# (first Lavender, then Surface0 matching wofi's #input) on top of a
# glass card -- rejected directly, on sight, as "exactly what i dont
# want": a card that's already blurred/translucent (layer_effects
# "notifications" + background-color below) doesn't also need a second,
# separate solid-ish layer competing with it behind the text. wofi's
# #input is a genuinely separate interactive widget on top of its window
# that earns its own distinct panel; a toast's text isn't a second
# widget, it's just the toast's own content -- one glass surface, text
# sitting directly on it, not glass-behind-glass.
format=<b>%s</b>\n%b

# --- Icons ---
# Every notify-send call across this desktop's own scripts now passes a
# real icon (freedesktop icon-theme name, or an actual image path for the
# few that have one -- the wallpaper/screenshot success notifications use
# the actual new image as their image). Sized and rounded to match the
# rest of the desktop's rounded-pill aesthetic (waybar's 16px, this
# notification's own 12px outer radius) rather than mako's sharp-cornered
# default.
max-icon-size=48
icon-border-radius=8

# Real bug, found by testing rather than assuming icon names alone were
# enough: mako only ever searches /usr/share/icons/hicolor and
# /usr/share/pixmaps by default (its own docs say so explicitly) -- it
# does NOT do GTK-style icon-theme resolution or theme inheritance the
# way GTK apps do. This desktop's actual icon theme is candy-icons
# (`gsettings get org.gnome.desktop.interface icon-theme`), and NONE of
# the icon names used anywhere in this repo's scripts exist in hicolor --
# confirmed directly with `find`, e.g. docker-desktop.svg and
# battery-caution-symbolic.svg live only under candy-icons.
#
# candy-icons (Papirus's replacement as of the Candy migration) has no
# `status` icons for generic dialogs at all (no dialog-error/-warning/
# -information anywhere in the theme, confirmed with `find`) and no
# weather icons either -- gaps Papirus didn't have. AdwaitaLegacy (the
# old full-color, non-symbolic Adwaita icon set, `adwaita-icon-theme-legacy`)
# fills those specifically: real dialog-*/weather-clear* PNGs, still
# real-fill (not `fill:currentColor` like modern Adwaita's symbolic-only
# set, which would go near-invisible on this desktop's dark notification
# background the same way Papirus's `-symbolic` names once did). Adwaita
# itself listed last as a broad fallback for anything future scripts reach
# for that neither ships.
icon-path=/usr/share/icons/candy-icons:/usr/share/icons/AdwaitaLegacy:/usr/share/icons/Adwaita

# --- Elegant Colors ---
# Deep Midnight background at 0.35 alpha (0x59). wofi's own 0.85 was
# tried here first, matching its recipe exactly -- genuine finding,
# reported back rather than assumed: at wofi's alpha, an annotated
# zoomed screenshot showed the flat card body reading as a plain dark
# box, with the blur only visibly doing anything right at the rounded
# corner's edge antialiasing -- "dark background" (bad) vs "glass like
# background" (good, but only in that one corner) called out directly
# on the same real screenshot. At 420x~90px, this card is roughly 1/10th
# wofi's window's area -- 0.85 alpha leaves so little of the blur
# visible against that much less background area that it reads as
# basically opaque instead of glass. 0.35 lets the blur actually
# dominate the fill across the whole body, not just its edge, confirmed
# live over both the raw wallpaper and the dark terminal with text still
# legible in both.
background-color=#11111B59
# Clean silver text for easy readability
text-color=#CDD6F4
# Royal Mauve border, also matching wofi's own alpha (0.55) rather than
# fully solid -- a glass pane's edge reads as part of the glass, not a
# hard opaque frame around it.
border-color=#CBA6F78C
# Subtle tracking background for progress bars (like volume adjustments)
progress-color=over #313244

# --- Behavior ---
default-timeout=5000
ignore-timeout=0

# max-visible=1 -- real architectural limit, not a style choice: mako
# renders every simultaneously-visible notification as rows inside ONE
# shared layer-shell surface, confirmed directly via `swaymsg -t
# get_outputs` (3 stacked notifications reported as a single surface,
# 276px tall = 3x92, not three separate 92px ones). SwayFX's
# `corner_radius`/`blur` in sway/config's layer_effects apply to that
# one surface as a whole -- there's no way for the compositor to round
# or glass each entry independently, since it has no concept of mako's
# internal row boundaries; only the true outer edge of the whole shared
# panel ever gets the glass treatment, reported directly as "remove that
# external common container" once two-plus notifications piled up.
# max-visible=1 sidesteps this by construction: only ever one row exists
# in that surface at a time (mako's own default is 5, queuing the rest
# to appear after older ones expire/dismiss, not dropping them), so it's
# always the single, fully independent glass card this whole config is
# actually built for.
max-visible=1

# Keep dismissed/expired notifications so scripts/.local/bin/
# notification-history.py (the waybar bell icon, left of the clock) has
# something real to show -- off by default, mako drops notifications
# permanently otherwise. 200 is generous headroom without being
# unbounded; makoctl history/list both return JSON (`-j`), which is what
# that script actually parses.
history=1
max-history=200

# --- Sound ---
# message.oga -- the freedesktop stereo sound theme's default "new
# message" chime, 0.3s (checked every candidate's actual duration with
# ffprobe first rather than guessing from the filename -- the next
# shortest, message-new-instant.oga, runs a full second, noticeably more
# intrusive for something that fires on every single notification).
# Global here (before any [urgency=]/[mode=] section below), not inside
# one -- a real bug caught by testing this directly: an earlier version
# of this line placed after [urgency=high] was silently scoped to *only*
# that section, so normal-urgency notifications never played a sound at
# all despite parsing without any error. mako's own config format scopes
# every option to whatever section most recently opened above it, with
# no way to tell from the option alone -- worth remembering for anything
# added here later.
on-notify=exec paplay /usr/share/sounds/freedesktop/stereo/message.oga

# --- High Urgency Alerts ---
# Overrides the border to a warm peach tone if a system-critical event occurs
#
# Real bug found while chasing an unrelated report: mako's own config
# format only ever matches urgency= against "low", "normal", "critical"
# (confirmed directly, man mako(5)) -- "high" isn't one of the three,
# so this section has never matched a single real notification. Every
# notify-send -u critical call across this repo's scripts (every error
# notification there is) has been rendering with the default border and
# the default 5000ms timeout this whole time, not the peach border +
# "never auto-dismiss" this section was clearly meant to give it.
[urgency=critical]
border-color=#FAB387
default-timeout=0

# --- Low Urgency ---
# Quieter visual weight for the low end of the scale (hover/volume ticks,
# routine status) -- Surface2 Gray instead of Mauve, so the eye can tell
# "just FYI" apart from a normal notification without reading the text
# first, the same way waybar/sway already reserve a dim gray specifically
# for "off"/inactive states (caffeine.inactive, bluetooth.disabled) rather
# than reusing an accent color there too.
[urgency=low]
border-color=#585B70

# --- Overflow placeholder ---
# With max-visible=1 above, this is real: any 2nd+ notification arriving
# while one's already showing means there's always at least one more
# queued, so mako's own "(N more)" placeholder row would show
# permanently -- and that row is a second entry in the same shared
# surface as the real notification, recreating the exact "external
# container" problem max-visible=1 was added to fix in the first place
# (one shared rounded/glass panel with two flat-divided rows inside it,
# instead of one independent card). `hidden` is mako's own documented
# criteria field specifically for styling this placeholder (`man
# mako(5)`'s CRITERIA section) -- invisible=1 suppresses the row
# entirely rather than fixing its style, which is what's actually wanted
# here: the queued count was never something this desktop's own
# notifications needed to announce, only that the current one is real
# and unobstructed.
[hidden]
invisible=1

# --- Notification modes ---
# scripts/.local/bin/notification-mode.sh switches between these three
# with `makoctl mode -s <name>` -- see that script for the full design
# (why silent/dnd exist, the waybar bell icon + keybindings + scroll
# switching it). "default" (mako's own built-in initial mode, not
# redefined here) is the implicit fourth state: popup shows, sound
# plays, both inherited from the global settings above with nothing to
# override.
[mode=silent]
# Popup still shows (nothing here says otherwise -- inherits every
# geometry/color/timeout setting above unchanged); only the sound is
# cancelled. "none" is on-notify's own documented no-op action, not an
# empty value -- confirmed directly: `on-notify=` with nothing after the
# `=` fails to parse at all ("Failed to parse option 'on-notify='"),
# mako's config format has no bare-empty-value convention here.
on-notify=none

[mode=dnd]
# invisible=1 stops the popup from ever rendering -- confirmed directly
# with the notification's own distinctive Mauve border color (zero
# matching pixels found in a screenshot after firing one in this mode,
# versus a real, matching count when the same check ran against silent
# mode's popup) -- and separately confirmed it does NOT stop the
# notification from being recorded to history (the whole point: DND
# notifications are still fully browsable via notification-history.py
# afterward, just without interrupting anything in the moment).
#
# invisible=1 alone does NOT also cancel on-notify, though -- a real bug
# caught by testing rather than assuming "invisible" implies "silent"
# too: an earlier version of this section had only invisible=1, and a
# sound played anyway despite no popup ever appearing (confirmed with an
# unambiguous marker-file side effect on on-notify, not by ear). Needs
# the same explicit on-notify=none as [mode=silent] above.
invisible=1
on-notify=none
