# ~/.config/mako/config

# --- Geometry & Positioning ---
# Anchors alerts to the top right corner, perfectly clear of the Waybar pills
anchor=top-right
margin=10,20,0,0
# width is a fixed value (mako's own docs: no shrink-to-fit); height is
# a *maximum*, shrunk to fit shorter text -- confirmed directly (man
# mako(5)). That combination is exactly why these looked square-ish:
# most everyday notifications here are short (1-2 lines), so height
# was already shrinking well below its old 150px cap while width sat
# fixed at 350 regardless -- reads as a boxier shape than the raw
# numbers alone suggest, especially with a 48px icon eating into the
# narrower content column. Widened to 420 and capped height lower at
# 130 (still generous for a wrapped 3-4 line body) so the box reads as
# a clear horizontal toast across the actual range of real notification
# lengths this desktop's scripts send, not just in the numeric ratio.
width=420
height=130
border-size=2
border-radius=12
padding=15

# --- Typography ---
font=JetBrainsMono Nerd Font 12
markup=1
#
# Real ask: replicate wofi's actual glass recipe (wofi/style.css), not
# just "translucent somewhere" -- wofi gets its look from THREE things
# together: (1) real compositor blur behind the whole window
# (layer_effects "wofi" in sway/config), (2) that window's own
# background at 0.85 alpha, tuned specifically so blurred-wallpaper
# brightness doesn't wash out text (wofi/style.css's own comment on
# raising it from 0.62), and (3) its #input field layered on top with
# its OWN distinct tint (Surface0 at 0.45 alpha) -- a second glass layer
# sitting on the first, not a flat solid box. mako can do (1) and (2)
# exactly the same way (see layer_effects "notifications" in
# sway/config) since both are compositor/background-color mechanics, but
# (3) has no real equivalent: mako's `format` is Pango markup
# (markup=1), which can tint a `<span background=...>` behind text, but
# that's a flat fill with no blur of its own -- the closest available
# approximation of a second glass layer, not the real thing GTK CSS
# gives wofi.
#
# `bgalpha="45%"` (Pango's own documented attribute for span background
# transparency) does NOT work here -- confirmed directly: it makes
# `makoctl reload` fail outright with "Unable to parse configuration
# file", while the exact same span with only `background=` and no
# `bgalpha` reloads fine. Worked around with an 8-digit RGBA hex directly
# in `background` itself instead -- confirmed this parses AND actually
# renders translucent. `#313244` (Surface0) at the same 0.45 alpha as
# wofi's own #input, rather than the Lavender tint tried initially, so
# the text panel's color matches wofi's layered-input look, not just its
# opacity. Leading/trailing spaces inside each span are deliberate
# padding: Pango's span background hugs the glyph bounding box exactly
# with none of its own, so the chip would otherwise clip tight to the
# letters.
format=<span background="#31324473"><b> %s </b></span>\n<span background="#31324473"> %b </span>

# --- Icons ---
# Every notify-send call across this desktop's own scripts now passes a
# real icon (freedesktop icon-theme name, or an actual image path for the
# few that have one -- the wallpaper/screenshot success notifications use
# the actual new image as their image). Sized and rounded to match the
# rest of the desktop's rounded-pill aesthetic (waybar's 16px, this
# notification's own 12px outer radius) rather than mako's sharp-cornered
# default.
max-icon-size=48
icon-border-radius=8

# Real bug, found by testing rather than assuming icon names alone were
# enough: mako only ever searches /usr/share/icons/hicolor and
# /usr/share/pixmaps by default (its own docs say so explicitly) -- it
# does NOT do GTK-style icon-theme resolution or theme inheritance the
# way GTK apps do. This desktop's actual icon theme is Papirus-Dark
# (`gsettings get org.gnome.desktop.interface icon-theme`), and NONE of
# the icon names used anywhere in this repo's scripts exist in hicolor --
# confirmed directly with `find`, e.g. docker-desktop.svg,
# edit-copy-symbolic.svg, dialog-error-symbolic.svg all live only under
# Papirus. Net effect before this fix: every single notification's icon
# silently failed to resolve and the popup fell back to no icon at all,
# regardless of how correct the icon name passed to notify-send was --
# this is almost certainly what "notifications don't show icons" was
# actually seeing, not a per-icon naming problem.
#
# Papirus-Dark itself is nearly empty (3972 files, mostly dark-tinted
# folder/places variants) and declares `Inherits=breeze-dark,hicolor` in
# its own index.theme -- but mako doesn't follow that either, and
# breeze-dark isn't even installed here. So Papirus-Dark alone isn't
# enough -- the full Papirus theme (65991 files) is what actually has
# every icon this repo's scripts reference, confirmed directly: every
# name from every notify-send/-i call across this repo resolves under
# Papirus. Adwaita listed last as a broad fallback for anything future
# scripts reach for that Papirus doesn't ship.
icon-path=/usr/share/icons/Papirus-Dark:/usr/share/icons/Papirus:/usr/share/icons/Adwaita

# --- Elegant Colors ---
# Deep Midnight background at 0.85 alpha (0xd9) -- the exact value
# wofi/style.css uses for this same base color, restored again alongside
# real compositor blur (layer_effects "notifications" in sway/config).
# The earlier attempt at this exact combination read as "a window into
# the wallpaper" rather than glass; going back to it deliberately this
# time specifically BECAUSE it's wofi's own real, working recipe, not
# guessed independently -- if it still doesn't read as glass at this
# card's small size, that's a genuine finding worth reporting back, not
# a reason to quietly water it down again.
background-color=#11111Bd9
# Clean silver text for easy readability
text-color=#CDD6F4
# Royal Mauve border, also matching wofi's own alpha (0.55) rather than
# fully solid -- a glass pane's edge reads as part of the glass, not a
# hard opaque frame around it.
border-color=#CBA6F78C
# Subtle tracking background for progress bars (like volume adjustments)
progress-color=over #313244

# --- Behavior ---
default-timeout=5000
ignore-timeout=0

# Keep dismissed/expired notifications so scripts/.local/bin/
# notification-history.py (the waybar bell icon, left of the clock) has
# something real to show -- off by default, mako drops notifications
# permanently otherwise. 200 is generous headroom without being
# unbounded; makoctl history/list both return JSON (`-j`), which is what
# that script actually parses.
history=1
max-history=200

# --- Sound ---
# message.oga -- the freedesktop stereo sound theme's default "new
# message" chime, 0.3s (checked every candidate's actual duration with
# ffprobe first rather than guessing from the filename -- the next
# shortest, message-new-instant.oga, runs a full second, noticeably more
# intrusive for something that fires on every single notification).
# Global here (before any [urgency=]/[mode=] section below), not inside
# one -- a real bug caught by testing this directly: an earlier version
# of this line placed after [urgency=high] was silently scoped to *only*
# that section, so normal-urgency notifications never played a sound at
# all despite parsing without any error. mako's own config format scopes
# every option to whatever section most recently opened above it, with
# no way to tell from the option alone -- worth remembering for anything
# added here later.
on-notify=exec paplay /usr/share/sounds/freedesktop/stereo/message.oga

# --- High Urgency Alerts ---
# Overrides the border to a warm peach tone if a system-critical event occurs
#
# Real bug found while chasing an unrelated report: mako's own config
# format only ever matches urgency= against "low", "normal", "critical"
# (confirmed directly, man mako(5)) -- "high" isn't one of the three,
# so this section has never matched a single real notification. Every
# notify-send -u critical call across this repo's scripts (every error
# notification there is) has been rendering with the default border and
# the default 5000ms timeout this whole time, not the peach border +
# "never auto-dismiss" this section was clearly meant to give it.
[urgency=critical]
border-color=#FAB387
default-timeout=0

# --- Low Urgency ---
# Quieter visual weight for the low end of the scale (hover/volume ticks,
# routine status) -- Surface2 Gray instead of Mauve, so the eye can tell
# "just FYI" apart from a normal notification without reading the text
# first, the same way waybar/sway already reserve a dim gray specifically
# for "off"/inactive states (caffeine.inactive, bluetooth.disabled) rather
# than reusing an accent color there too.
[urgency=low]
border-color=#585B70

# --- Notification modes ---
# scripts/.local/bin/notification-mode.sh switches between these three
# with `makoctl mode -s <name>` -- see that script for the full design
# (why silent/dnd exist, the waybar bell icon + keybindings + scroll
# switching it). "default" (mako's own built-in initial mode, not
# redefined here) is the implicit fourth state: popup shows, sound
# plays, both inherited from the global settings above with nothing to
# override.
[mode=silent]
# Popup still shows (nothing here says otherwise -- inherits every
# geometry/color/timeout setting above unchanged); only the sound is
# cancelled. "none" is on-notify's own documented no-op action, not an
# empty value -- confirmed directly: `on-notify=` with nothing after the
# `=` fails to parse at all ("Failed to parse option 'on-notify='"),
# mako's config format has no bare-empty-value convention here.
on-notify=none

[mode=dnd]
# invisible=1 stops the popup from ever rendering -- confirmed directly
# with the notification's own distinctive Mauve border color (zero
# matching pixels found in a screenshot after firing one in this mode,
# versus a real, matching count when the same check ran against silent
# mode's popup) -- and separately confirmed it does NOT stop the
# notification from being recorded to history (the whole point: DND
# notifications are still fully browsable via notification-history.py
# afterward, just without interrupting anything in the moment).
#
# invisible=1 alone does NOT also cancel on-notify, though -- a real bug
# caught by testing rather than assuming "invisible" implies "silent"
# too: an earlier version of this section had only invisible=1, and a
# sound played anyway despite no popup ever appearing (confirmed with an
# unambiguous marker-file side effect on on-notify, not by ear). Needs
# the same explicit on-notify=none as [mode=silent] above.
invisible=1
on-notify=none
