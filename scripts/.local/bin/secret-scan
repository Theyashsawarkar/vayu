#!/usr/bin/env bash
# secret-scan: no secret ever leaves this machine through git.
#
# Run by the global git hooks (git/.config/git/hooks): before every commit
# (what's staged) and before every push (the commits going out). Fails closed:
# a hit, or no gitleaks to check with, stops the commit or push.
#
#   secret-scan staged            what's staged (pre-commit)
#   secret-scan range <revs...>   commits, e.g. origin/main..HEAD (pre-push)
#
# Three checks, and none of them prints the secret itself, only where it is:
#   1. gitleaks: API keys, tokens, private keys, passwords in code...
#   2. files that are secrets by their nature: keystores, private keys, .env
#   3. your own private strings (phone numbers, addresses...): one extended
#      regex per line in ~/.config/git/private-patterns, which lives only on
#      this machine (never in a repo: the list would itself be the leak).
#
# A false alarm: fix the file (a placeholder, an env var), or allow that one
# finding with a `gitleaks:allow` comment on its line, or its fingerprint in
# the repo's .gitleaksignore. Never `--no-verify`.
set -uo pipefail
private=${SECRET_SCAN_PATTERNS:-$HOME/.config/git/private-patterns}
red=$'\033[1;31m' dim=$'\033[2m' off=$'\033[0m'
found=0
say() { printf '%s\n' "$*" >&2; }
hit() { found=1; say "${red}secret-scan:${off} $*"; }

# Names that are secrets whatever they hold. *.example / *.sample / *.template are fine.
SECRET_FILES='(^|/)(id_(rsa|dsa|ecdsa|ed25519)|[^/]*\.(pem|key|p12|pfx|jks|keystore|kdbx|ppk|gpg|asc)|\.env(\.[^/]*)?|\.netrc|\.npmrc|\.pypirc|credentials(\.json)?|service-account[^/]*\.json|keystore\.pass|[^/]*secrets?\.(json|ya?ml|toml))$'
ALLOWED_FILES='(\.(example|sample|template|dist)$|(^|/)debug\.keystore$|\.pub$)'

check_names() { # file names on stdin
  local f
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    if [[ "$f" =~ $SECRET_FILES ]] && ! [[ "$f" =~ $ALLOWED_FILES ]]; then
      hit "$f is a secret by its kind (a key, a keystore, an .env): keep it out of git (.gitignore it)"
    fi
  done
}

check_private() { # a unified diff on stdin; only added lines count
  [ -s "$private" ] || return 0
  local pats file="" n line
  pats=$(grep -v -E '^\s*(#|$)' "$private")
  [ -n "$pats" ] || return 0
  while IFS= read -r line; do
    case "$line" in
      "+++ b/"*) file=${line#+++ b/} ;;
      "@@ "*) n=$(sed -E 's/^@@ -[0-9,]+ \+([0-9]+).*/\1/' <<<"$line"); n=$((n - 1)) ;;
      "+"*)
        n=$((n + 1))
        if grep -q -E -f <(printf '%s\n' "$pats") <<<"${line:1}"; then
          hit "$file:$n holds one of your private strings (~/.config/git/private-patterns)"
        fi ;;
      " "*) n=$((n + 1)) ;;
    esac
  done
}

need_gitleaks() {
  command -v gitleaks >/dev/null && return 0
  hit "gitleaks isn't installed, so nothing can be checked: sudo pacman -S gitleaks"
  exit 1
}

case "${1:-}" in
  staged)
    need_gitleaks
    gitleaks git --pre-commit --staged --redact --no-banner --log-level warn . >&2 || hit "gitleaks found a secret in what's staged (above, redacted)"
    check_names < <(git diff --cached --name-only --diff-filter=ACMR)
    check_private < <(git diff --cached -U0 --no-color --diff-filter=ACMR)
    ;;
  range)
    shift
    [ "$#" -gt 0 ] || { say "usage: secret-scan range <revs...>"; exit 2; }
    need_gitleaks
    [ -n "$(git rev-list "$@" 2>/dev/null | head -1)" ] || exit 0 # nothing new goes out
    gitleaks git --log-opts="$*" --redact --no-banner --log-level warn . >&2 || hit "gitleaks found a secret in the commits going out (above, redacted)"
    check_names < <(git log --format= --name-only --diff-filter=ACMR "$@" | sort -u)
    check_private < <(git log --format= -p -U0 --no-color --diff-filter=ACMR "$@")
    ;;
  *) say "usage: secret-scan staged | range <revs...>"; exit 2 ;;
esac

if [ "$found" = 1 ]; then
  say "${dim}Nothing was committed or pushed. Remove the secret (a placeholder, an env var), or mark a false alarm with gitleaks:allow / .gitleaksignore.${off}"
  exit 1
fi
exit 0
