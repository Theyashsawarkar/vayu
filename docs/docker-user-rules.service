[Unit]
Description=Re-apply DOCKER-USER firewall hardening after docker starts
# DOCKER-USER is reset to empty every time dockerd (re)starts, so this
# must run again after every docker.service start -- see
# docs/DOCKER_SECURITY.md for why and how to test this.
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# @DOTFILES@ is filled in at install time (see docs/DOCKER_SECURITY.md),
# so this works for any user, not just one home directory.
ExecStart=/usr/bin/bash @DOTFILES@/docs/harden-docker.sh

[Install]
WantedBy=multi-user.target
